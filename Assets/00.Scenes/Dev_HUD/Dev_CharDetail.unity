--- !u!114 &985834738
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 985834736}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 70bb0047534feba46b44006bbe403d39, type: 3}
  m_Name:
  m_EditorClassIdentifier: Shinshi.Runtime::Shinshi.UI.UiLayoutNote
  _layoutId: emuxidlrdtwhf
  _condition: 0
  _description: "\uCE90\uB9AD\uD130 \uC815\uBCF4 \uC694\uC57D. \uBAA8\uB4E0 \uAC12\uC740
    \uB370\uC774\uD130 \uC5F0\uACB0 \uC804 \uD45C\uC2DC\uC6A9 \uC608\uC2DC. \uD76C\uADC0
    \uC81C\uC791 \uC7A5\uBE44 6\uBD80\uC704 +17, \uC218\uB828 \uACF5\uACA910/\uC0DD\uBA8510/\uBC29\uC5B47/\uCE58\uBA855/\uAE30\uB8255(\uCD1D37)\uB97C
    \uAE30\uC900\uC73C\uB85C \uACC4\uC0B0. \uC7A5\uBE44 \uD569 \uACF5\uACA9544.32/\uC0DD\uBA852041.2/\uBC29\uC5B4226.8/\uCE58\uBA852%p.
    \uCE90\uB9AD\uD130 \uB808\uBCA8\xB7\uACBD\uD5D8\uCE58\xB7\uC544\uC774\uD15C \uB808\uBCA8\xB7\uBBF8\uC815\uC778
    \uC885\uD569 \uC804\uD22C\uB825\uC740 \uD45C\uC2DC\uD558\uC9C0 \uC54A\uB294\uB2E4.
    \uBD80\uC801\uC740 \uAE30\uC220 \uBCC0\uD615 \uC608\uC2DC\uC774\uBA70 \uC0C1\uC2DC
    \uB2A5\uB825\uCE58 \uC99D\uAC10 \uC5C6\uB294 \uC870\uD569\uC744 \uAC00\uC815\uD55C\uB2E4.
    \uC6D0\uBCF8 v2 \uD615\uC2DD\uC5D0 \uB9DE\uCDB0 \uD45C\uC2DC \uBB38\uC790\uC5F4\uC740
    \uB178\uB4DC \uC774\uB984\uACFC description\uC5D0 \uAE30\uB85D\uD55C\uB2E4."
