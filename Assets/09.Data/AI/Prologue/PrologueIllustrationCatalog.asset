--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f4be12e9fde499a46adbb316bcfc9da1, type: 3}
  m_Name: PrologueIllustrationCatalog
  m_EditorClassIdentifier: Shinshi.Runtime::Shinshi.AI.PrologueIllustrationCatalogSO
  _intro:
  - _image: {fileID: 21300000, guid: c3e008941d07fa04a9a43190f5581702, type: 3}
    _text: "\uC778\uAC04\uACFC \uC2E0\uB839\uC774 \uD568\uAED8 \uD130\uB97C \uC7A1\uC740
      \uACF3, \uC2E0\uC2DC.\n\uC11C\uB85C \uB2E4\uB978 \uC774\uB4E4\uC774 \uC774\uACF3\uC5D0\uC11C
      \uC0B6\uC744 \uC774\uC5B4 \uC654\uB2E4."
  - _image: {fileID: 21300000, guid: 8201d8f3f2e8c2148861035ae0b2ec2d, type: 3}
    _text: "\uC0AC\uB78C\uB4E4\uC740 \uBB34\uC608\uB97C \uC775\uD788\uACE0, \uBD80\uC801\uC758
      \uAC00\uB974\uCE68\uC744 \uC774\uC5B4\uBC1B\uC558\uB2E4.\n\uC18C\uC911\uD55C
      \uC774\uB4E4\uACFC \uC0B6\uC758 \uD130\uC804\uC744 \uC9C0\uD0A4\uAE30 \uC704\uD574."
  - _image: {fileID: 21300000, guid: a3a1f06ca9b2daf48b94ab5bc8ab7efa, type: 3}
    _text: "\uADF8\uB7EC\uB098 \uC232 \uB108\uBA38\uC5D0\uC11C \uC778\uAC04\uC744
      \uC2B5\uACA9\uD558\uB294 \uC0B0\uADC0\uB4E4\uC774 \uB098\uD0C0\uB0AC\uB2E4.\n\uD769\uC5B4\uC838
      \uC788\uB358 \uC2B5\uACA9\uC758 \uD754\uC801\uC740 \uC810\uCC28 \uD558\uB098\uC758
      \uC232\uC73C\uB85C \uC774\uC5B4\uC84C\uB2E4."
  - _image: {fileID: 21300000, guid: 16fb51f4aa71c164f81f0f7fd9a7537a, type: 3}
    _text: "\uC2E0\uC2DC\uC758 \uD1A0\uBC8C\uB300\uC6D0\uC778 \uB2F9\uC2E0\uC740
      \uADF8 \uD754\uC801\uC744 \uB530\uB77C \uC232\uC73C\uB85C \uD5A5\uD588\uB2E4."
  _talisman:
  - _image: {fileID: 21300000, guid: bb2dde7f471ae004bb635a9137e06e2c, type: 3}
    _text: "\uC2E0\uC2DC\uC758 \uBD80\uC801\uACFC \uB2EE\uC740 \uBB38\uC591\uC774\uB2E4."
  _appearance:
  - _image: {fileID: 21300000, guid: 14323255913318543b31b8648dc2259a, type: 3}
    _text: "\uADF8 \uBD80\uC801\u2026\u2026 \uC544\uC9C1\uB3C4 \uC778\uAC04\uC5D0\uAC8C
      \uC804\uD574\uC9C0\uACE0 \uC788\uC5C8\uAD6C\uB098."
  _ending:
  - _image: {fileID: 21300000, guid: 3370fa9925d5426408ae0df18cdf8af0, type: 3}
    _text: 
  - _image: {fileID: 21300000, guid: a6da71c6b038d8b4fa32f4fd8dac5397, type: 3}
    _text: "\u2026\u2026\uC774\uB300\uB85C\uB294 \uC0C1\uB300\uD560 \uC218 \uC5C6\uC5B4.\n\uC2E0\uC2DC\uB85C
      \uB3CC\uC544\uAC00\uC790. \uB2E4\uC2DC \uB9DE\uC124 \uD798\uC774 \uD544\uC694\uD574."
  _inkWipeMaterial: {fileID: 2100000, guid: 6d03c3dddd81c0e489135e5f5b982056, type: 2}
  _font: {fileID: 11400000, guid: 41bb4f9c604e41a438b947123d8b3145, type: 2}
  _subtitleFont: {fileID: 11400000, guid: 9c595fba874703e4d85d8d7d0277bebc, type: 2}
