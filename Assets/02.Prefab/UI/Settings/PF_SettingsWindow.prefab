  m_Script: {fileID: 11500000, guid: 70bb0047534feba46b44006bbe403d39, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Shinshi.Runtime::Shinshi.UI.UiLayoutNote
  _layoutId: catlist
  _condition: 0
  _description: "\uC635\uC158 \uD0ED\uC758 \uBD84\uB958. \uADF8\uB798\uD53D\uC774
    \uC5F4\uB824 \uC788\uACE0 \uC18C\uBD84\uB958\uAC00 \uBCF4\uC778\uB2E4. \uAC8C\uC784\uD50C\uB808\uC774
    = \uC7A1\uADC0 \uCCB4\uB825 \uBC14 \xB7 \uC9C0\uB3C4 \uC5EC\uB294 \uBC29\uC2DD,
