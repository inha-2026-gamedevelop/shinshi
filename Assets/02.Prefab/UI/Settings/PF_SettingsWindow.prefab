  _title: "\uD30C\uD2F0\uC6D0 \uC774\uD399\uD2B8 \uD22C\uBA85\uB3C4"
  _description: "\uD30C\uD2F0\uC6D0\uC774 \uC4F0\uB294 \uC2A4\uD0AC \uC774\uD399\uD2B8\uC758
    \uD22C\uBA85\uB3C4\uB97C \uC870\uC808\uD569\uB2C8\uB2E4. \uB0AE\uCD94\uBA74 \uD30C\uD2F0
    \uC804\uD22C\uC5D0\uC11C \uD654\uBA74\uC774 \uB35C \uBCF5\uC7A1\uD574\uC9C0\uACE0
    0%\uB85C \uB450\uBA74 \uD30C\uD2F0\uC6D0 \uC774\uD399\uD2B8\uB97C \uADF8\uB9AC\uC9C0
    \uC54A\uC2B5\uB2C8\uB2E4. \uBAAC\uC2A4\uD130\uC758 \uACF5\uACA9 \uD45C\uC2DC\uC640
    \uB0B4 \uD53C\uACA9 \uC774\uD399\uD2B8\uB294 \uD56D\uC0C1 \uBCF4\uC785\uB2C8\uB2E4."
  _normalColor: {r: 0.095, g: 0.118, b: 0.14, a: 1}
  _hoverColor: {r: 0.145, g: 0.15, b: 0.16, a: 1}
