# ══════════════════════════════════════════════════════
#  shinshi — Git 속성 설정
#  Unity 텍스트 병합 + Git LFS 대용량 바이너리 관리
#  병합 드라이버와 LFS 준비는 docs/unity/UNITY_START_HERE.md
# ══════════════════════════════════════════════════════

* text=auto

# ─── Unity 직렬화 파일 ────────────────────────────────
# UnityYAMLMerge 사용. 씬은 원칙적으로 동시 편집 금지.
*.unity      -text merge=unityyamlmerge diff
*.prefab     -text merge=unityyamlmerge diff
*.asset      -text merge=unityyamlmerge diff
*.mat        -text merge=unityyamlmerge diff
*.anim       -text merge=unityyamlmerge diff
*.controller -text merge=unityyamlmerge diff
*.overrideController -text merge=unityyamlmerge diff
*.physicMaterial     -text merge=unityyamlmerge diff
*.physicsMaterial2D  -text merge=unityyamlmerge diff
*.playable   -text merge=unityyamlmerge diff
*.mask       -text merge=unityyamlmerge diff
*.brush      -text merge=unityyamlmerge diff
*.flare      -text merge=unityyamlmerge diff
*.fontsettings -text merge=unityyamlmerge diff
*.guiskin    -text merge=unityyamlmerge diff
*.giparams   -text merge=unityyamlmerge diff
*.meta       -text merge=unityyamlmerge diff
*.lighting   -text merge=unityyamlmerge diff

# ─── Git LFS: 이미지 ──────────────────────────────────
*.png  filter=lfs diff=lfs merge=lfs -text
*.jpg  filter=lfs diff=lfs merge=lfs -text
*.jpeg filter=lfs diff=lfs merge=lfs -text
*.tga  filter=lfs diff=lfs merge=lfs -text
*.tif  filter=lfs diff=lfs merge=lfs -text
*.tiff filter=lfs diff=lfs merge=lfs -text
*.psd  filter=lfs diff=lfs merge=lfs -text
*.exr  filter=lfs diff=lfs merge=lfs -text
*.hdr  filter=lfs diff=lfs merge=lfs -text

# ─── Git LFS: 3D 모델 ─────────────────────────────────
*.fbx   filter=lfs diff=lfs merge=lfs -text
*.obj   filter=lfs diff=lfs merge=lfs -text
*.blend filter=lfs diff=lfs merge=lfs -text
*.dae   filter=lfs diff=lfs merge=lfs -text
*.3ds   filter=lfs diff=lfs merge=lfs -text
*.max   filter=lfs diff=lfs merge=lfs -text

# ─── Git LFS: 오디오 ──────────────────────────────────
*.wav  filter=lfs diff=lfs merge=lfs -text
*.mp3  filter=lfs diff=lfs merge=lfs -text
*.ogg  filter=lfs diff=lfs merge=lfs -text
*.aif  filter=lfs diff=lfs merge=lfs -text

# ─── Git LFS: 영상 ────────────────────────────────────
*.mp4 filter=lfs diff=lfs merge=lfs -text
*.mov filter=lfs diff=lfs merge=lfs -text
*.webm filter=lfs diff=lfs merge=lfs -text

# ─── Git LFS: 지형 데이터 ─────────────────────────────
# *.asset 전체를 LFS로 보내면 안 된다 — GameDB 등 일반 ScriptableObject까지 딸려간다.
# TerrainData처럼 큰 .asset이 생기면 그 경로만 따로 적는다.
*.terrainlayer filter=lfs diff=lfs merge=lfs -text
*.raw  filter=lfs diff=lfs merge=lfs -text
# 마을 지형 브러시가 씬마다 만드는 메시 사본. 한 개가 수 MB라 경로만 LFS로 보낸다.
Assets/01.Scripts/05.Art/Environment/VillageGroundPatch/CarvedMeshes/**/*.asset   filter=lfs diff=lfs merge=lfs -text
Assets/01.Scripts/05.Art/Environment/VillageGroundPatch/SculptedMeshes/**/*.asset filter=lfs diff=lfs merge=lfs -text

# ─── Git LFS: 폰트 · 압축 ─────────────────────────────
*.ttf filter=lfs diff=lfs merge=lfs -text
*.otf filter=lfs diff=lfs merge=lfs -text
*.7z  filter=lfs diff=lfs merge=lfs -text

# ─── 문서 ─────────────────────────────────────────────
*.md text eol=lf
