POSTGRES_DB=shinshi
POSTGRES_USER=shinshi
POSTGRES_PORT=5432
POSTGRES_PASSWORD=<provide-through-environment>

# .NET API settings: provide actual values through environment variables or secrets
ConnectionStrings__Postgres=<DML-only-runtime-connection-string-from-environment>
ConnectionStrings__PostgresMigrator=<migration-owner-connection-string-from-environment>

# Token signing and build policy (no default signing secret)
Auth__HashKeyBase64=<base64-of-at-least-32-random-bytes-from-secret-store>
AuthBuild__ProtocolVersion=<protocol-version-integer>
AuthBuild__ContentHash=<matching-client-and-server-content-hash>
# With ConnectionStrings__Postgres, login, public service state and new sorties read DB service_state
# (0008 starts in maintenance with no allowed builds); change it with PUT /admin/v1/service-state.
# Join-token exchange still reads ServiceState__Maintenance directly, so keep it false in that case

ServiceState__AllowedBuildIds__0=<allowed-build-id>
ServiceState__Maintenance=false

# Operator admin (/admin/v1). TOTP key: base64 of exactly 32 random bytes from the secret store.
# Empty AllowedNetworks means loopback only
# DANGER behind a proxy: AllowedNetworks is checked against the address restored from X-Forwarded-For.
# A request the proxy forwards without that header keeps the proxy address, so startup fails when any
# ForwardedHeaders__KnownProxies address is inside AllowedNetworks (or is loopback while AllowedNetworks is empty).
# List only the operators' real client networks (VPN, office), never the proxy or load balancer subnet.
# Without KnownProxies, admin requests carrying X-Forwarded-For or Forwarded are hidden (404) and logged once
Admin__TotpKeyBase64=<base64-of-32-random-bytes-from-secret-store>
Admin__AllowedNetworks__0=<operator-cidr-for-example-10.0.0.0/8>
# Only while running --bootstrap-owner once; remove afterwards
SHINSHI_BOOTSTRAP_OWNER=<first-owner-login-name>
# Request-start logs include the query string. Invite codes are searched only with
# POST /admin/v1/accounts/search (body), and GET /admin/v1/accounts?query= accepts UUIDs only.
# Raise this category where logs are shipped off the host
# Logging__LogLevel__Microsoft.AspNetCore.Hosting.Diagnostics=Warning

# Player classes open for character creation and town entry (comma separated IDs, 0..5).
# 0,1,2 are always open. The new classes 3 (swordsman), 4 (mageknight) and 5 (archer) stay closed
# (creation answers 409 FEATURE_DISABLED) until listed here. Default is 0,1,2
# Characters__EnabledClassIds=0,1,2

# Fixed server registrations; never supply the service credential plaintext here
ServerCredentials__LeaseLifetimeSeconds=900
ServerCredentials__Registrations__0__ServiceId=<registered-service-uuid>
ServerCredentials__Registrations__0__InstanceId=<registered-instance-uuid>
ServerCredentials__Registrations__0__Role=<0-for-town-or-1-for-dungeon>
ServerCredentials__Registrations__0__CredentialHashBase64=<sha256-base64-of-service-credential-from-secret-store>

# Only behind a load balancer: the exact proxy IPs whose X-Forwarded-For is trusted. Leave unset otherwise.
# These addresses must stay outside Admin__AllowedNetworks (see the admin section above)
# ForwardedHeaders__KnownProxies__0=<load-balancer-private-ip>