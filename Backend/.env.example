POSTGRES_DB=shinshi
POSTGRES_USER=shinshi
POSTGRES_PORT=5432
POSTGRES_PASSWORD=<provide-through-environment>

# .NET API settings: provide actual values through environment variables or secrets
ConnectionStrings__Postgres=<DML-only-runtime-connection-string-from-environment>
ConnectionStrings__PostgresMigrator=<migration-owner-connection-string-from-environment>

# Token signing and build policy (no default signing secret)
Auth__HashKeyBase64=<base64-of-at-least-32-random-bytes-from-secret-store>
AuthBuild__ProtocolVersion=<protocol-version-integer>
AuthBuild__ContentHash=<matching-client-and-server-content-hash>
ServiceState__AllowedBuildIds__0=<allowed-build-id>
ServiceState__Maintenance=false

# Fixed server registrations; never supply the service credential plaintext here
ServerCredentials__LeaseLifetimeSeconds=900
ServerCredentials__Registrations__0__ServiceId=<registered-service-uuid>
ServerCredentials__Registrations__0__InstanceId=<registered-instance-uuid>
ServerCredentials__Registrations__0__Role=<0-for-town-or-1-for-dungeon>
ServerCredentials__Registrations__0__CredentialHashBase64=<sha256-base64-of-service-credential-from-secret-store>

# Only behind a load balancer: the exact proxy IPs whose X-Forwarded-For is trusted. Leave unset otherwise
# ForwardedHeaders__KnownProxies__0=<load-balancer-private-ip>