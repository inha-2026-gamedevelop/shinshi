@page "/service-state"
@inherits AdminPageBase
@using Newtonsoft.Json.Linq
<PageTitle>서비스 상태 · 신시 운영</PageTitle>
<div class="page-head">
    <div>
        <h1><Icon Name="server" /> 서비스 상태</h1>
        <p>점검·기능 차단·허용 빌드를 한 번에 저장합니다. 저장할 때는 조회한 리비전을 함께 보냅니다.</p>
    </div>
    <LoadingButton Variant="secondary" Busy="_busy" Disabled="HasPrepared" IconName="refresh" OnClick="LoadAsync">최신 상태 조회 · 편집값 불러오기</LoadingButton>
</div>
<RoleRequirement MinimumRole="AdminContractCodes.Role.ADMIN" />
<div class="grid two">
    <section class="card" aria-labelledby="state-now">
        <div class="card-head"><Icon Name="activity" /><h2 id="state-now">현재 상태</h2></div>
        @if (!_loaded)
        {
            <p class="muted">상단의 조회 버튼으로 최신 상태를 불러오세요. 저장하면 다시 조회해야 합니다.</p>
        }
        else
        {
            <div class="row">
                <span class="@("badge " + (_maintenance ? "danger" : "ok"))"><Icon Name="@(_maintenance ? "wrench" : "check-circle")" /> @(_maintenance ? "점검 중" : "정상 운영")</span>
                <span class="muted">리비전 <code>@_revision</code></span>
            </div>
            <p class="field-label mt">차단된 기능</p>
            @if (_disabled.Count == 0)
            {
                <p class="muted">없음</p>
            }
            else
            {
                <div class="chip-list">@foreach (string feature in ServiceFeatureKeys.All.Where(_disabled.Contains)) { <span class="badge warn">@AdminLabels.Feature(feature)</span> }</div>
            }
            <p class="muted">허용 빌드 @_builds.Count 개</p>
        }
    </section>
    <section class="card" aria-labelledby="state-edit">
        <div class="card-head"><Icon Name="wrench" /><h2 id="state-edit">점검 · 기능 · 허용 빌드 변경</h2></div>
        <fieldset disabled="@(FormLocked || !_loaded || !Context.HasRole(AdminContractCodes.Role.ADMIN))">
            <label class="switch-row"><input type="checkbox" @bind="_maintenance" /> 점검 중으로 표시</label>
            <h3 class="mt">기능 차단</h3>
            <div class="form-grid cols-2">
            @foreach (string feature in ServiceFeatureKeys.All)
            {
                <label class="check"><input type="checkbox" checked="@_disabled.Contains(feature)" @onchange="eventArgs => ToggleFeature(feature, eventArgs)" /> @AdminLabels.Feature(feature) <small class="muted">&nbsp;(@feature)</small></label>
            }
            </div>
            <h3 class="mt">허용 빌드</h3>
            <div class="chip-list">
            @foreach (string build in _builds.ToArray())
            {
                <span class="chip"><code>@build</code> <button type="button" class="ghost icon-only small" aria-label="@(build + " 삭제")" @onclick="() => _builds.Remove(build)"><Icon Name="x" /></button></span>
            }
            </div>
            <div class="row nowrap mt"><label class="field grow">추가할 빌드 ID<input @bind="_newBuild" maxlength="128" placeholder="빌드 ID" /></label>
                <button type="button" class="secondary" @onclick="AddBuild"><Icon Name="plus" /> 빌드 추가</button></div>
            <label class="field mt">변경 사유 <input @bind="_reason" maxlength="500" placeholder="@AdminDefaults.SERVICE_STATE_REASON" /></label>
            <p class="default-hint">비우면 "@AdminDefaults.SERVICE_STATE_REASON"</p>
            <div class="actions"><LoadingButton IconName="check" OnClick="PrepareUpdate">저장 내용 확인</LoadingButton></div>
        </fieldset>
        <p class="hint">리비전 충돌(409)이면 현재 요청을 닫고 최신 상태를 다시 조회하여 변경 내용을 확인하세요.</p>
    </section>
</div>
<WriteConfirmation Title="@_writeTitle" Target="@_writeTarget" Body="_preparedBody" OperationId="@PendingOperationId" Attempted="_writeAttempted" CanConfirm="CanConfirm" Busy="_busy" Defaults="_writeDefaults" OnConfirm="ConfirmAsync" OnCancel="CancelPrepared" />
<ApiResultView Data="_data" Error="@_error" Message="@_message" Busy="_busy" />
@code
{
    /****************************************
    *                Fields
    ****************************************/

    private bool _loaded;
    private bool _maintenance;
    private long _revision;
    private readonly HashSet<string> _disabled = new(StringComparer.Ordinal);
    private readonly List<string> _builds = new();
    private string _newBuild = string.Empty;
    private string _reason = string.Empty;

    /****************************************
    *                Methods
    ****************************************/

    private Task LoadAsync() => ReadAsync(AdminApiRoutes.SERVICE_STATE);

    protected override void OnReadResponse(JToken? value)
    {
        if (value == null)
        {
            return;
        }
        _maintenance = value["maintenance"]?.Value<bool>() ?? true;
        _revision = value["revision"]?.Value<long>() ?? 0;
        _disabled.Clear();
        foreach (JToken feature in value["disabledFeatures"] as JArray ?? new JArray())
        {
            _disabled.Add(feature.ToString());
        }
        _builds.Clear();
        _builds.AddRange((value["allowedBuildIds"] as JArray ?? new JArray()).Select(build => build.ToString()));
        _loaded = true;
    }

    private void ToggleFeature(string feature, ChangeEventArgs eventArgs)
    {
        if (eventArgs.Value is true)
        {
            _disabled.Add(feature);
        }
        else
        {
            _disabled.Remove(feature);
        }
    }

    private void AddBuild()
    {
        Validate(() =>
        {
            string build = _newBuild.Trim();
            if ((build.Length == 0) || (build.Length > AdminServiceStateUpdateRequest.MAX_BUILD_ID_LENGTH)
                || (_builds.Count >= AdminServiceStateUpdateRequest.MAX_BUILD_IDS) || (_builds.Contains(build, StringComparer.Ordinal)))
            {
                throw new ArgumentException("빌드 ID는 중복 없이 1~128자로 입력하세요. 목록은 최대 64개입니다.");
            }
            _builds.Add(build);
            _newBuild = string.Empty;
        });
    }

    private void PrepareUpdate()
    {
        Validate(() =>
        {
            if (!_loaded)
            {
                throw new ArgumentException("최신 상태를 먼저 조회하세요.");
            }
            WriteDefaults defaults = new();
            string reason = defaults.Reason(_reason, AdminDefaults.SERVICE_STATE_REASON);
            bool maintenance = _maintenance;
            long revision = _revision;
            string[] features = ServiceFeatureKeys.All.Where(_disabled.Contains).ToArray();
            string[] builds = _builds.ToArray();
            Prepare("서비스 상태 저장", "서비스 전체 / 리비전 " + revision, reason, AdminContractCodes.Role.ADMIN,
                AdminApiRoutes.SERVICE_STATE, operation => new AdminServiceStateUpdateRequest(operation, reason,
                    maintenance, features, builds, revision), HttpMethod.Put, defaults);
        });
    }

    protected override void OnWriteResponse(JToken? value) { _loaded = false; }

    protected override string WriteFailureMessage(AdminWebApiResult<JToken> result)
    {
        if ((result.StatusCode == 409) && (result.ReasonCode == AdminContractCodes.RejectReason.INVALID_STATE))
        {
            return "다른 운영자가 먼저 서비스 상태를 변경했을 수 있습니다. 요청을 닫고 최신 상태를 다시 조회한 뒤 변경 내용을 확인하세요.";
        }
        return base.WriteFailureMessage(result);
    }
}
