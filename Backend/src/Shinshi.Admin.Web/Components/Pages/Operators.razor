@page "/operators"
@inherits AdminPageBase
@using Newtonsoft.Json.Linq
<PageTitle>운영자 · 신시 운영</PageTitle>
<div class="page-head">
    <div>
        <h1><Icon Name="shield" /> 운영자</h1>
        <p>운영자 계정을 만들고 비활성화합니다. 초기 비밀값은 생성 응답에서 한 번만 볼 수 있습니다.</p>
    </div>
    <LoadingButton Variant="secondary" Busy="_busy" Disabled="!Context.HasRole(AdminContractCodes.Role.OWNER)" IconName="refresh" OnClick="LoadAsync">운영자 목록 조회</LoadingButton>
</div>
<RoleRequirement MinimumRole="AdminContractCodes.Role.OWNER" />
<OneTimeSecretView @ref="_secretView" />
<div class="grid two">
    <section class="card" aria-labelledby="op-create">
        <div class="card-head"><Icon Name="plus" /><h2 id="op-create">운영자 생성</h2></div>
        <fieldset disabled="@(FormLocked || !Context.HasRole(AdminContractCodes.Role.OWNER))">
            <div class="form-grid cols-2">
                <label class="field">로그인 이름 <input @bind="_loginName" minlength="3" maxlength="64" autocomplete="off" placeholder="소문자·숫자·점·밑줄·하이픈 3~64자" /></label>
                <label class="field">역할
                    <select @bind="_role"><option value="0">Viewer · 조회</option><option value="1">Operator · 운영</option><option value="2">Admin · 관리자</option><option value="3">Owner · 소유자</option></select></label>
            </div>
            <label class="field mt">생성 사유 <input @bind="_createReason" maxlength="500" placeholder="@AdminDefaults.OPERATOR_CREATE_REASON" /></label>
            <p class="default-hint">비우면 "@AdminDefaults.OPERATOR_CREATE_REASON"</p>
            <div class="actions"><LoadingButton IconName="check" OnClick="PrepareCreate">생성 내용 확인</LoadingButton></div>
        </fieldset>
    </section>
    <section class="card" aria-labelledby="op-disable">
        <div class="card-head"><Icon Name="ban" /><h2 id="op-disable">운영자 비활성화</h2></div>
        <fieldset disabled="@(FormLocked || !Context.HasRole(AdminContractCodes.Role.OWNER))">
            <p class="muted">열린 어드민 세션도 폐기합니다. 자기 자신과 마지막 활성 Owner는 비활성화할 수 없습니다.</p>
            <div class="form-grid cols-2">
                <label class="field">운영자 ID <input @bind="_adminId" placeholder="운영자 ID(UUID)" /></label>
                <label class="field">비활성화 사유 <input @bind="_disableReason" maxlength="500" placeholder="@AdminDefaults.OPERATOR_DISABLE_REASON" /></label>
            </div>
            <p class="default-hint">비우면 "@AdminDefaults.OPERATOR_DISABLE_REASON"</p>
            <div class="actions"><LoadingButton Variant="danger" IconName="ban" OnClick="PrepareDisable">비활성화 내용 확인</LoadingButton></div>
        </fieldset>
    </section>
</div>
<WriteConfirmation Title="@_writeTitle" Target="@_writeTarget" Body="_preparedBody" OperationId="@PendingOperationId" Attempted="_writeAttempted" CanConfirm="CanConfirm" Busy="_busy" Defaults="_writeDefaults" OnConfirm="ConfirmAsync" OnCancel="CancelPrepared" />
<ApiResultView Data="_data" Error="@_error" Message="@_message" Busy="_busy" />
@code
{
    /****************************************
    *                Fields
    ****************************************/

    private OneTimeSecretView? _secretView;
    private string _loginName = string.Empty;
    private int _role;
    private string _createReason = string.Empty;
    private string _adminId = string.Empty;
    private string _disableReason = string.Empty;
    private bool _creating;

    /****************************************
    *                Methods
    ****************************************/

    private Task LoadAsync() => ReadAsync(AdminApiRoutes.OPERATORS);

    private void PrepareCreate()
    {
        Validate(() =>
        {
            string name = _loginName.Trim().ToLowerInvariant();
            if ((name.Length < 3) || (name.Length > 64) || !System.Text.RegularExpressions.Regex.IsMatch(name, "^[a-z0-9._-]+$"))
            {
                throw new ArgumentException("로그인 이름은 소문자·숫자·점·밑줄·하이픈으로 3~64자입니다.");
            }
            WriteDefaults defaults = new();
            string reason = defaults.Reason(_createReason, AdminDefaults.OPERATOR_CREATE_REASON);
            int role = _role;
            if ((role < AdminContractCodes.Role.VIEWER) || (role > AdminContractCodes.Role.OWNER))
            {
                throw new ArgumentException("역할을 선택하세요.");
            }
            _secretView?.Clear();
            _creating = true;
            Prepare("운영자 생성", name, reason, AdminContractCodes.Role.OWNER, AdminApiRoutes.OPERATORS,
                operation => new AdminOperatorCreateRequest(operation, reason, name, role), defaults: defaults);
        });
    }

    private void PrepareDisable()
    {
        Validate(() =>
        {
            string admin = Id(_adminId, "운영자 ID");
            WriteDefaults defaults = new();
            string reason = defaults.Reason(_disableReason, AdminDefaults.OPERATOR_DISABLE_REASON);
            if (admin == Context.AdminId)
            {
                throw new ArgumentException("자기 자신은 비활성화할 수 없습니다.");
            }
            _creating = false;
            Prepare("운영자 비활성화", admin, reason, AdminContractCodes.Role.OWNER,
                string.Format(AdminApiRoutes.OPERATOR_DISABLE_FORMAT, admin),
                operation => new AdminOperatorDisableRequest(operation, reason), defaults: defaults);
        });
    }

    protected override void OnWriteResponse(JToken? value)
    {
        if ((!_creating) || (value is not JObject response))
        {
            return;
        }
        Dictionary<string, string> secrets = new();
        foreach ((string Key, string Label) field in new[] { ("initialPassword", "초기 비밀번호"), ("totpSecretBase32", "TOTP 비밀(Base32)"), ("totpUri", "인증 앱 등록 URI") })
        {
            string? secret = response[field.Key]?.Value<string>();
            response.Remove(field.Key);
            if (!string.IsNullOrEmpty(secret))
            {
                secrets.Add(field.Label, secret);
            }
        }
        _adminId = response["adminId"]?.ToString() ?? string.Empty;
        _secretView?.Show(secrets, "재전송 응답에는 초기 비밀값이 없습니다. 잃었다면 이 운영자를 비활성화하고 새로 만드세요.");
    }

    protected override void ClearSensitiveState() { _secretView?.Clear(); }
}
