@page "/accounts"
@inherits AdminPageBase
<PageTitle>계정 조회와 조정</PageTitle>
<h1>계정 조회와 조정</h1>
<RoleRequirement MinimumRole="AdminContractCodes.Role.VIEWER" />
<section>
    <h2>계정 검색</h2>
    <div class="form-grid">
        <label>검색 방식<select @bind="_searchMode"><option value="id">계정·캐릭터 UUID</option><option value="invite">초대 코드</option><option value="name">캐릭터 이름(정확 일치)</option></select></label>
        <label>검색값<input @bind="_query" autocomplete="off" /></label>
        <label class="checkbox"><input type="checkbox" @bind="_includeDeleted" disabled="@(_searchMode != "name")" /> 삭제 캐릭터 포함</label>
    </div>
    <button type="button" disabled="@_busy" @onclick="FindAsync">검색</button>
    <p class="muted">캐릭터 이름과 초대 코드는 POST 본문으로 전송됩니다.</p>
</section>
<section>
    <h2>계정 상세</h2>
    <div class="form-grid"><label>계정 ID<input @bind="_accountId" /></label><label>조회 사유<input @bind="_detailReason" maxlength="500" /></label></div>
    <button type="button" disabled="@_busy" @onclick="DetailAsync">상세 조회</button>
</section>
<RoleRequirement MinimumRole="AdminContractCodes.Role.OPERATOR" />
<fieldset disabled="@(FormLocked || !Context.HasRole(AdminContractCodes.Role.OPERATOR))">
    <legend>로그인 토큰 폐기</legend>
    <p>현재 게임 접속은 유지됩니다. 이미 발급된 로그인·접근·갱신 토큰을 폐기하며, 아이디와 비밀번호 로그인을 막지는 않습니다.</p>
    <label class="checkbox"><input type="checkbox" @bind="_revokeInvites" /> 미폐기 초대도 함께 폐기</label>
    <label>변경 사유<input @bind="_kickReason" maxlength="500" /></label>
    <button type="button" @onclick="PrepareKick">폐기 내용 확인</button>
</fieldset>
<fieldset disabled="@(FormLocked || !Context.HasRole(AdminContractCodes.Role.OPERATOR))">
    <legend>개인 자산 조정</legend>
    <div class="form-grid">
        <label>자산 종류<select @bind="_assetKind"><option value="Currency">엽전</option><option value="Tickets">입장권</option><option value="Essence">정기</option><option value="Shards">파편</option><option value="AccountItem">계정 아이템</option></select></label>
        @if (_assetKind == AdminGrantCodes.ASSET_ACCOUNT_ITEM)
        {
            <label>아이템 정의 ID<input @bind="_assetId" /></label><label>귀속<select @bind="_binding"><option value="Account">계정 귀속</option></select></label>
        }
        @if ((_assetKind == AdminGrantCodes.ASSET_ESSENCE) || (_assetKind == AdminGrantCodes.ASSET_SHARDS))
        {
            <label>대상 캐릭터 ID<input @bind="_characterId" /></label>
        }
        <label>증감량(음수는 회수)<input type="number" @bind="_delta" min="-1000000" max="1000000" /></label>
        <label>변경 사유<input @bind="_adjustReason" maxlength="500" /></label>
    </div>
    <p class="muted">회수는 예약분을 뺀 가용량까지 적용합니다. 결과의 부족분을 확인하세요.</p>
    <button type="button" @onclick="PrepareAdjustment">조정 내용 확인</button>
</fieldset>
<WriteConfirmation Title="@_writeTitle" Target="@_writeTarget" Body="_preparedBody" OperationId="@PendingOperationId" Attempted="_writeAttempted" CanConfirm="CanConfirm" Busy="_busy" OnConfirm="ConfirmAsync" OnCancel="CancelPrepared" />
<ApiResultView Data="_data" Error="@_error" Message="@_message" Busy="_busy" />
@code
{
    /****************************************
    *                Fields
    ****************************************/

    private string _searchMode = "id";
    private string _query = string.Empty;
    private bool _includeDeleted;
    private string _accountId = string.Empty;
    private string _detailReason = string.Empty;
    private string _kickReason = string.Empty;
    private bool _revokeInvites = true;
    private string _assetKind = AdminGrantCodes.ASSET_CURRENCY;
    private string _assetId = string.Empty;
    private string _binding = "Account";
    private string _characterId = string.Empty;
    private long _delta = 1;
    private string _adjustReason = string.Empty;

    /****************************************
    *                Methods
    ****************************************/

    private async Task FindAsync()
    {
        string? path = null;
        object? request = null;
        Validate(() =>
        {
            if (_searchMode == "id")
            {
                path = Query(AdminApiRoutes.ACCOUNTS, ("query", Id(_query, "검색값")));
            }
            else if (_searchMode == "name")
            {
                if (string.IsNullOrWhiteSpace(_query))
                {
                    throw new ArgumentException("캐릭터 이름을 입력하세요.");
                }
                request = new AdminAccountSearchRequest(null!, _query, _includeDeleted);
            }
            else
            {
                if (string.IsNullOrWhiteSpace(_query))
                {
                    throw new ArgumentException("초대 코드를 입력하세요.");
                }
                request = new AdminAccountSearchRequest(_query.Trim());
            }
        });
        if (!string.IsNullOrEmpty(_error))
        {
            return;
        }
        if (path != null)
        {
            await ReadAsync(path);
        }
        else if (request != null)
        {
            await SearchAsync(request);
        }
        _query = string.Empty;
    }

    private async Task DetailAsync()
    {
        string? path = null;
        Validate(() => path = Query(string.Format(AdminApiRoutes.ACCOUNT_FORMAT, Id(_accountId, "계정 ID")),
            ("reason", RequireReason(_detailReason))));
        if (path != null)
        {
            await ReadAsync(path);
        }
    }

    private void PrepareKick()
    {
        Validate(() =>
        {
            string account = Id(_accountId, "계정 ID");
            string reason = RequireReason(_kickReason);
            bool revoke = _revokeInvites;
            Prepare("로그인 토큰 폐기", account, reason, AdminContractCodes.Role.OPERATOR,
                string.Format(AdminApiRoutes.ACCOUNT_KICK_FORMAT, account),
                operation => new AdminAccountKickRequest(operation, reason, revoke));
        });
    }

    private void PrepareAdjustment()
    {
        Validate(() =>
        {
            string account = Id(_accountId, "계정 ID");
            string reason = RequireReason(_adjustReason);
            string kind = _assetKind;
            string? asset = kind == AdminGrantCodes.ASSET_ACCOUNT_ITEM ? Optional(_assetId) : null;
            if ((kind == AdminGrantCodes.ASSET_ACCOUNT_ITEM) && (asset == null))
            {
                throw new ArgumentException("아이템 정의 ID를 입력하세요.");
            }
            string? binding = kind == AdminGrantCodes.ASSET_ACCOUNT_ITEM ? _binding : null;
            string? character = ((kind == AdminGrantCodes.ASSET_ESSENCE) || (kind == AdminGrantCodes.ASSET_SHARDS))
                ? Id(_characterId, "캐릭터 ID") : null;
            long delta = _delta;
            if ((delta == 0) || (delta < -AdminGrantCodes.MAX_ADJUSTMENT) || (delta > AdminGrantCodes.MAX_ADJUSTMENT))
            {
                throw new ArgumentException("증감량은 0을 제외한 -1,000,000~1,000,000입니다.");
            }
            Prepare("개인 자산 조정", account, reason, AdminContractCodes.Role.OPERATOR,
                string.Format(AdminApiRoutes.ACCOUNT_ADJUSTMENTS_FORMAT, account),
                operation => new AdminAdjustmentRequest(operation, reason, kind, asset!, binding!, character!, delta));
        });
    }

    protected override void ClearSensitiveState()
    {
        _query = string.Empty;
    }
}