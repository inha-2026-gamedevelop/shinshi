@page "/recovery"
@inherits AdminPageBase
@using Newtonsoft.Json.Linq
<PageTitle>장애 복구</PageTitle>
<h1>장애 복구</h1>
<RoleRequirement MinimumRole="AdminContractCodes.Role.VIEWER" />
<section>
    <h2>복구 대상 세션</h2>
    <div class="form-grid">
        <label>세션 상태<select @bind="_state"><option value="">복구 관심 대상</option><option>Reserved</option><option>Loading</option><option>Starting</option><option>Running</option><option>Settling</option><option>Auction</option><option>Returning</option><option>RecoveryPending</option><option>Closed</option></select></label>
        <label>페이지 크기<input type="number" @bind="_limit" min="1" max="500" /></label>
    </div>
    <div class="actions">
        <button type="button" disabled="@_busy" @onclick="() => LoadSessionsAsync(false)">세션 첫 페이지 조회</button>
        <button type="button" class="secondary" disabled="@(_busy || string.IsNullOrEmpty(_sessionCursor))" @onclick="() => LoadSessionsAsync(true)">같은 필터로 다음 페이지</button>
    </div>
    @if (_sessions?["livenessDeferred"]?.Value<bool>() == true)
    {
        <p class="warning">서버 생존 판정이 보류 중입니다. 서버 소실을 확정할 수 없으며 장애 취소·강제 종료가 보류됩니다.</p>
    }
    <JsonDataView Value="_sessions" />
</section>
<section>
    <h2>경매 출정</h2>
    <div class="form-grid">
        <label>품목 상태<select @bind="_auctionState"><option value="">멈춘 경매</option><option value="Open">진행 중</option><option value="Closing">마감 중</option></select></label>
        <label>페이지 크기<input type="number" @bind="_auctionLimit" min="1" max="500" /></label>
    </div>
    <div class="actions">
        <button type="button" disabled="@_busy" @onclick="() => LoadAuctionsAsync(false)">경매 첫 페이지 조회</button>
        <button type="button" class="secondary" disabled="@(_busy || string.IsNullOrEmpty(_auctionCursor))" @onclick="() => LoadAuctionsAsync(true)">같은 필터로 다음 페이지</button>
    </div>
    <p class="muted">경매 자동 마감은 유지 작업이 처리합니다. 목록은 출정·예약 엽전·마감 상태를 확인하는 용도입니다.</p>
    <JsonDataView Value="_auctions" />
</section>
<RoleRequirement MinimumRole="AdminContractCodes.Role.ADMIN" />
<fieldset disabled="@(FormLocked || !Context.HasRole(AdminContractCodes.Role.ADMIN))">
    <legend>세션 수동 복구</legend>
    <div class="form-grid">
        <label>대상 세션 ID<input @bind="_sessionId" /></label>
        <label>복구 동작<select @bind="_action"><option value="RetrySettlement">저장된 종료 이벤트로 정산 재시도</option><option value="ServiceCancel" disabled="@LivenessDeferred">서버 소실 세션 장애 취소</option><option value="ForceClose" disabled="@LivenessDeferred">격리 정산 세션 강제 종료</option></select></label>
        <label>복구 사유<input @bind="_reason" maxlength="500" /></label>
    </div>
    <p>정산 재시도는 Settling, 장애 취소는 서버 소실 Running, 강제 종료는 복구 실패 5회 이상인 Settling에서 적용됩니다. RecoveryPending 처리 경로는 없습니다.</p>
    <button type="button" @onclick="PrepareRecovery">복구 내용 확인</button>
</fieldset>
<WriteConfirmation Title="@_writeTitle" Target="@_writeTarget" Body="_preparedBody" OperationId="@PendingOperationId" Attempted="_writeAttempted" CanConfirm="CanConfirm" Busy="_busy" OnConfirm="ConfirmAsync" OnCancel="CancelPrepared" />
<ApiResultView Data="_data" Error="@_error" Message="@_message" Busy="_busy" />
@code
{
    /****************************************
    *                Fields
    ****************************************/

    private string _state = string.Empty;
    private int _limit = AdminLogQueryParameters.DEFAULT_LIMIT;
    private string _auctionState = string.Empty;
    private int _auctionLimit = AdminLogQueryParameters.DEFAULT_LIMIT;
    private JToken? _sessions;
    private JToken? _auctions;
    private string? _sessionPath;
    private string? _auctionPath;
    private string? _sessionCursor;
    private string? _auctionCursor;
    private string _sessionId = string.Empty;
    private string _action = AdminSessionRecoveryCodes.RETRY_SETTLEMENT;
    private string _reason = string.Empty;

    private bool LivenessDeferred => _sessions?["livenessDeferred"]?.Value<bool>() == true
        || _auctions?["livenessDeferred"]?.Value<bool>() == true;

    /****************************************
    *                Methods
    ****************************************/

    private async Task LoadSessionsAsync(bool next)
    {
        string? path = null;
        Validate(() =>
        {
            if (next)
            {
                if ((_sessionPath != null) && (!string.IsNullOrEmpty(_sessionCursor)))
                {
                    path = _sessionPath + (_sessionPath.Contains('?') ? "&" : "?") + "cursor=" + Uri.EscapeDataString(_sessionCursor);
                }
            }
            else
            {
                CheckLimit(_limit);
                _sessionPath = Query(AdminApiRoutes.SESSIONS, ("state", Optional(_state)), ("limit", Number(_limit)));
                path = _sessionPath;
            }
        });
        if (path != null)
        {
            await ReadAsync(path);
            _sessions = _data;
            _sessionCursor = _sessions?["nextCursor"]?.Value<string>();
            _data = null;
        }
    }

    private async Task LoadAuctionsAsync(bool next)
    {
        string? path = null;
        Validate(() =>
        {
            if (next)
            {
                if ((_auctionPath != null) && (!string.IsNullOrEmpty(_auctionCursor)))
                {
                    path = _auctionPath + (_auctionPath.Contains('?') ? "&" : "?") + "cursor=" + Uri.EscapeDataString(_auctionCursor);
                }
            }
            else
            {
                CheckLimit(_auctionLimit);
                _auctionPath = Query(AdminApiRoutes.AUCTIONS, ("state", Optional(_auctionState)), ("limit", Number(_auctionLimit)));
                path = _auctionPath;
            }
        });
        if (path != null)
        {
            await ReadAsync(path);
            _auctions = _data;
            _auctionCursor = _auctions?["nextCursor"]?.Value<string>();
            _data = null;
        }
    }

    private void PrepareRecovery()
    {
        Validate(() =>
        {
            string session = Id(_sessionId, "세션 ID");
            string reason = RequireReason(_reason);
            string action = _action;
            if ((LivenessDeferred) && (action != AdminSessionRecoveryCodes.RETRY_SETTLEMENT))
            {
                throw new ArgumentException("서버 생존 판정 보류 중입니다. 최신 목록을 조회한 뒤 복구하세요.");
            }
            Prepare("세션 수동 복구", session, reason, AdminContractCodes.Role.ADMIN,
                string.Format(AdminApiRoutes.SESSION_RECOVERY_FORMAT, session),
                operation => new AdminSessionRecoveryRequest(operation, reason, action));
        });
    }

    private static void CheckLimit(int limit)
    {
        if ((limit < 1) || (limit > AdminLogQueryParameters.MAX_LIMIT))
        {
            throw new ArgumentException("페이지 크기는 1~500입니다.");
        }
    }

    protected override void ClearSensitiveState()
    {
        _sessions = null;
        _auctions = null;
        _sessionPath = null;
        _auctionPath = null;
        _sessionCursor = null;
        _auctionCursor = null;
    }
}