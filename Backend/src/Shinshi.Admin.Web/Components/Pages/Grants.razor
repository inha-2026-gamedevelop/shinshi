@page "/grants"
@inherits AdminPageBase
@using Newtonsoft.Json.Linq
<PageTitle>운영자 지급</PageTitle>
<h1>운영자 지급</h1>
<RoleRequirement MinimumRole="AdminContractCodes.Role.OPERATOR" />
<p>작성은 초안만 만듭니다. 실행하면 대상 우편함에 넣고, 취소하면 미수령분만 취소합니다.</p>
<fieldset disabled="@(FormLocked || !Context.HasRole(AdminContractCodes.Role.OPERATOR))">
    <legend>지급 초안 작성</legend>
    <div class="form-grid">
        <label>대상 계정 ID(줄마다 UUID 하나, 최대 1,000개)<textarea @bind="_targets" rows="4"></textarea></label>
        <label>수령 기한(일)<input type="number" @bind="_claimDays" min="1" max="365" /></label>
        <label>지급 출처<select @bind="_sourceKind"><option value="AdminGrant">일반 운영 지급</option><option value="RecoveryCompensation">장애 보정 지급</option></select></label>
        <label>출처 참조(장애 보정은 세션 ID 필수)<input @bind="_sourceRef" maxlength="200" /></label>
        <label>작성 사유<input @bind="_createReason" maxlength="500" /></label>
    </div>
    <h2>보상</h2>
    @for (int i = 0; i < _rewards.Count; ++i)
    {
        GrantRewardInput reward = _rewards[i];
        <div class="form-grid" @key="reward">
            <label>자산 종류<select @bind="reward.AssetKind"><option value="Currency">엽전</option><option value="Tickets">입장권</option><option value="Essence">정기</option><option value="Shards">파편</option><option value="AccountItem">계정 아이템</option></select></label>
            @if (reward.AssetKind == AdminGrantCodes.ASSET_ACCOUNT_ITEM)
            {
                <label>아이템 정의 ID<input @bind="reward.AssetId" /></label><p>귀속: 계정</p>
            }
            <label>수량<input type="number" @bind="reward.Quantity" min="1" max="1000000" /></label>
            <button type="button" class="secondary" disabled="@(_rewards.Count == 1)" @onclick="() => _rewards.Remove(reward)">보상 줄 삭제</button>
        </div>
    }
    <button type="button" class="secondary" disabled="@(_rewards.Count >= AdminGrantCodes.MAX_REWARD_LINES)" @onclick="() => _rewards.Add(new GrantRewardInput())">보상 줄 추가</button>
    <button type="button" @onclick="PrepareCreate">초안 내용 확인</button>
</fieldset>
<section>
    <h2>지급 상세</h2>
    <label>지급 ID<input @bind="_grantId" /></label>
    <button type="button" disabled="@(_busy || !Context.HasRole(AdminContractCodes.Role.OPERATOR))" @onclick="LoadAsync">상세 조회</button>
</section>
<fieldset disabled="@(FormLocked || !Context.HasRole(AdminContractCodes.Role.OPERATOR))">
    <legend>지급 실행·취소</legend>
    <label>변경 사유<input @bind="_actionReason" maxlength="500" /></label>
    <p class="muted">대상 2명 이상 또는 장애 보정 지급 실행은 Admin 이상입니다. Operator는 상세 조회 후 1명 일반 지급을 실행할 수 있습니다.</p>
    <div class="actions">
        <button type="button" disabled="@(!CanExecute)" @onclick="() => PrepareAction(true)">실행 내용 확인</button>
        <button type="button" class="secondary" @onclick="() => PrepareAction(false)">취소 내용 확인</button>
    </div>
</fieldset>
<WriteConfirmation Title="@_writeTitle" Target="@_writeTarget" Body="_preparedBody" OperationId="@PendingOperationId" Attempted="_writeAttempted" CanConfirm="CanConfirm" Busy="_busy" OnConfirm="ConfirmAsync" OnCancel="CancelPrepared" />
<ApiResultView Data="_data" Error="@_error" Message="@_message" Busy="_busy" />
@code
{
    /****************************************
    *                Fields
    ****************************************/

    private string _targets = string.Empty;
    private int _claimDays = AdminGrantCodes.DEFAULT_CLAIM_DAYS;
    private string _sourceKind = AdminGrantCodes.SOURCE_ADMIN_GRANT;
    private string _sourceRef = string.Empty;
    private string _createReason = string.Empty;
    private readonly List<GrantRewardInput> _rewards = new() { new GrantRewardInput() };
    private string _grantId = string.Empty;
    private string _actionReason = string.Empty;
    private JToken? _grantDetail;

    private bool CanExecute => Context.HasRole(AdminContractCodes.Role.ADMIN)
        || ((Context.HasRole(AdminContractCodes.Role.OPERATOR))
        && (Guid.TryParse(_grantId, out Guid id)) && (id.ToString("D") == _grantDetail?["grantId"]?.ToString())
        && (_grantDetail?["targetCount"]?.Value<int>() == 1)
        && (_grantDetail?["sourceKind"]?.ToString() == AdminGrantCodes.SOURCE_ADMIN_GRANT));

    /****************************************
    *                Methods
    ****************************************/

    private void PrepareCreate()
    {
        Validate(() =>
        {
            string[] accounts = _targets.Split(new[] { '\r', '\n', ',', ' ', '\t' }, StringSplitOptions.RemoveEmptyEntries)
                .Select(value => Id(value, "대상 계정 ID")).ToArray();
            if ((accounts.Length < 1) || (accounts.Length > AdminGrantCodes.MAX_TARGET_ACCOUNTS)
                || (accounts.Distinct(StringComparer.Ordinal).Count() != accounts.Length))
            {
                throw new ArgumentException("대상 계정은 중복 없는 UUID 1~1,000개로 입력하세요.");
            }
            AdminGrantReward[] rewards = _rewards.Select(reward =>
            {
                if ((reward.Quantity < 1) || (reward.Quantity > AdminGrantCodes.MAX_REWARD_QUANTITY))
                {
                    throw new ArgumentException("보상 수량은 1~1,000,000입니다.");
                }
                bool item = reward.AssetKind == AdminGrantCodes.ASSET_ACCOUNT_ITEM;
                if ((item) && (string.IsNullOrWhiteSpace(reward.AssetId)))
                {
                    throw new ArgumentException("아이템 정의 ID를 입력하세요.");
                }
                return new AdminGrantReward(reward.AssetKind, item ? reward.AssetId.Trim() : null!,
                    item ? "Account" : null!, reward.Quantity);
            }).ToArray();
            string reason = RequireReason(_createReason);
            int days = _claimDays;
            if ((days < AdminGrantCodes.MIN_CLAIM_DAYS) || (days > AdminGrantCodes.MAX_CLAIM_DAYS))
            {
                throw new ArgumentException("수령 기한은 1~365일입니다.");
            }
            string source = _sourceKind;
            string? reference = Optional(_sourceRef);
            if (source == AdminGrantCodes.SOURCE_RECOVERY_COMPENSATION)
            {
                reference = Id(_sourceRef, "보정 대상 세션 ID");
            }
            if (reference?.Length > AdminGrantCodes.MAX_SOURCE_REF_LENGTH)
            {
                throw new ArgumentException("출처 참조는 최대 200자입니다.");
            }
            Prepare("지급 초안 작성", accounts.Length + "개 계정", reason, AdminContractCodes.Role.OPERATOR,
                AdminApiRoutes.GRANTS, operation => new AdminGrantCreateRequest(operation, reason, accounts,
                    rewards, days, source, reference!));
        });
    }

    private async Task LoadAsync()
    {
        string? path = null;
        Validate(() => path = string.Format(AdminApiRoutes.GRANT_FORMAT, Id(_grantId, "지급 ID")));
        if (path != null)
        {
            await ReadAsync(path);
        }
    }

    protected override void OnReadResponse(JToken? value) { _grantDetail = value; }

    private void PrepareAction(bool execute)
    {
        Validate(() =>
        {
            string grant = Id(_grantId, "지급 ID");
            string reason = RequireReason(_actionReason);
            if ((execute) && (!CanExecute))
            {
                throw new ArgumentException("지급 상세와 실행 권한을 확인하세요.");
            }
            int role = execute && (_grantDetail?["targetCount"]?.Value<int>() > 1
                || _grantDetail?["sourceKind"]?.ToString() == AdminGrantCodes.SOURCE_RECOVERY_COMPENSATION)
                ? AdminContractCodes.Role.ADMIN : AdminContractCodes.Role.OPERATOR;
            Prepare(execute ? "지급 실행" : "미수령 지급 취소", grant, reason, role,
                string.Format(execute ? AdminApiRoutes.GRANT_EXECUTE_FORMAT : AdminApiRoutes.GRANT_CANCEL_FORMAT, grant),
                operation => new AdminGrantActionRequest(operation, reason));
        });
    }

    protected override void OnWriteResponse(JToken? value)
    {
        _grantId = value?["grantId"]?.ToString() ?? value?["grant"]?["grantId"]?.ToString() ?? _grantId;
        _grantDetail = value?["grant"];
    }

    protected override void ClearSensitiveState() { _grantDetail = null; }
}