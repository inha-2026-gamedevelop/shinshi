@page "/logs"
@inherits AdminPageBase
@using Newtonsoft.Json.Linq
<PageTitle>로그 · 신시 운영</PageTitle>
<div class="page-head">
    <div>
        <h1><Icon Name="scroll" /> 로그</h1>
        <p>원장·아이템·세션·작업 조회는 조회 사유를 감사 기록에 남깁니다. 시간 필터는 시작 포함·종료 제외이며 한국 시간(KST)입니다.</p>
    </div>
</div>
<RoleRequirement MinimumRole="AdminContractCodes.Role.VIEWER" />
<section class="card" aria-label="조회 조건">
    <div class="spread">
        <div class="seg" role="group" aria-label="조회 종류">
            <button type="button" aria-pressed="@(_tab == "ledger")" @onclick='() => SetTab("ledger")'>경제 원장</button>
            <button type="button" aria-pressed="@(_tab == "item")" @onclick='() => SetTab("item")'>아이템 이력</button>
            <button type="button" aria-pressed="@(_tab == "session")" @onclick='() => SetTab("session")'>세션 이벤트</button>
            <button type="button" aria-pressed="@(_tab == "operation")" @onclick='() => SetTab("operation")'>작업 추적</button>
            <button type="button" aria-pressed="@(_tab == "audit")" @onclick='() => SetTab("audit")'>운영 감사</button>
        </div>
        <label class="field reason-field">민감 조회 사유 <input @bind="_reason" maxlength="500" placeholder="@AdminDefaults.READ_REASON" /></label>
    </div>
    <p class="default-hint">사유를 비우면 "@AdminDefaults.READ_REASON" · 조회 개수를 비우면 @(AdminDefaults.LIST_LIMIT)개 · 기간을 비우면 최근 @(AdminDefaults.LOG_RANGE_HOURS)시간</p>
    @if (_tab == "ledger")
    {
        <div class="form-grid mt">
            <div class="wide"><AccountPicker @ref="_accountPicker" Label="캐릭터 이름 또는 계정 ID" Optional="true" Value="@_accountText" ValueChanged="value => _accountText = value"
                           Hint="비우면 아래 출처 종류·출처 ID로 조회합니다." /></div>
            <label class="field">캐릭터 ID (선택) <input @bind="_characterId" placeholder="캐릭터 ID(UUID)" /></label>
            <label class="field">출처 종류 <input @bind="_sourceType" placeholder="계정 없이 조회할 때 필수" /></label>
            <label class="field">출처 ID <input @bind="_sourceId" placeholder="계정 없이 조회할 때 필수" /></label>
            <label class="field">자산 종류 <input @bind="_assetKind" placeholder="전체" /></label>
            <label class="field">자산 ID <input @bind="_assetId" placeholder="전체" /></label>
            <label class="field">원장 사유 코드 <input @bind="_reasonCode" inputmode="numeric" placeholder="전체" /></label>
            <label class="field">조회 개수 <input @bind="_limit" inputmode="numeric" placeholder="@AdminDefaults.LIST_LIMIT" /></label>
        </div>
        <div class="form-grid cols-2 mt">
            <DateTimeField Label="시작 시각" @bind-Value="_from" DefaultHint="@("비우면 종료 시각 " + AdminDefaults.LOG_RANGE_HOURS + "시간 전(종료도 비면 지금부터)")" />
            <DateTimeField Label="종료 시각" @bind-Value="_to" DefaultHint="비우면 지금까지" />
        </div>
        <PeriodPresets OnPick="PickLedger" />
        <div class="actions"><LoadingButton Busy="_busy || _resolving" IconName="search" OnClick="LoadLedgerAsync">원장 첫 페이지 조회</LoadingButton></div>
        @if (_totals != null)
        {
            <details open><summary>원장 필터 전체 합계</summary><JsonDataView Value="_totals" /></details>
        }
    }
    else if (_tab == "item")
    {
        <label class="field mt">아이템 인스턴스 ID <input @bind="_itemId" placeholder="아이템 인스턴스 ID(UUID)" /></label>
        <div class="actions"><LoadingButton Busy="_busy" IconName="search" OnClick="LoadItemAsync">이력 조회</LoadingButton></div>
    }
    else if (_tab == "session")
    {
        <label class="field mt">세션 ID <input @bind="_sessionId" placeholder="세션 ID(UUID)" /></label>
        <div class="actions"><LoadingButton Busy="_busy" IconName="search" OnClick="LoadSessionAsync">세션 요약·참가자·이벤트 조회</LoadingButton></div>
    }
    else if (_tab == "operation")
    {
        <div class="form-grid cols-2 mt">
            <label class="field">행위자 ID <input @bind="_actorId" placeholder="행위자 ID(UUID)" /></label>
            <label class="field">작업 ID <input @bind="_operationId" placeholder="작업 ID(UUID)" /></label>
        </div>
        <div class="actions"><LoadingButton Busy="_busy" IconName="search" OnClick="LoadOperationAsync">작업·원장·이력·감사 조회</LoadingButton></div>
    }
    else
    {
        <div class="form-grid mt">
            <label class="field">운영자 ID (선택) <input @bind="_auditAdminId" placeholder="전체 운영자" /></label>
            <label class="field">대상 종류 (선택) <input @bind="_targetKind" placeholder="전체" /></label>
            <label class="field">대상 ID (종류와 함께) <input @bind="_targetId" placeholder="전체" /></label>
            <label class="field">조회 개수 <input @bind="_auditLimit" inputmode="numeric" placeholder="@AdminDefaults.LIST_LIMIT" /></label>
        </div>
        <div class="form-grid cols-2 mt">
            <DateTimeField Label="시작 시각" @bind-Value="_auditFrom" DefaultHint="@("비우면 종료 시각 " + AdminDefaults.LOG_RANGE_HOURS + "시간 전(종료도 비면 지금부터)")" />
            <DateTimeField Label="종료 시각" @bind-Value="_auditTo" DefaultHint="비우면 지금까지" />
        </div>
        <PeriodPresets OnPick="PickAudit" />
        <div class="actions"><LoadingButton Busy="_busy" IconName="search" OnClick="LoadAuditAsync">감사 첫 페이지 조회</LoadingButton></div>
    }
</section>
@if (_pagedPath != null)
{
    <section class="card result-card">
        <div class="spread">
            <div><strong>@_pageLabel</strong> <span class="muted">@_applied</span></div>
            <LoadingButton Variant="secondary" Busy="_busy" Disabled="string.IsNullOrEmpty(_cursor)" IconName="chevron-right" OnClick="NextAsync">같은 필터로 다음 페이지</LoadingButton>
        </div>
    </section>
}
<ApiResultView Data="_data" Error="@_error" Message="@_message" Busy="_busy" />
@code
{
    /****************************************
    *                Fields
    ****************************************/

    private AccountPicker? _accountPicker;
    private string _tab = "ledger";
    private string _reason = string.Empty;
    private string _accountText = string.Empty;
    private string _characterId = string.Empty;
    private string _sourceType = string.Empty;
    private string _sourceId = string.Empty;
    private string _assetKind = string.Empty;
    private string _assetId = string.Empty;
    private string _reasonCode = string.Empty;
    private string _from = string.Empty;
    private string _to = string.Empty;
    private string _limit = string.Empty;
    private string _itemId = string.Empty;
    private string _sessionId = string.Empty;
    private string _actorId = string.Empty;
    private string _operationId = string.Empty;
    private string _auditAdminId = string.Empty;
    private string _targetKind = string.Empty;
    private string _targetId = string.Empty;
    private string _auditFrom = string.Empty;
    private string _auditTo = string.Empty;
    private string _auditLimit = string.Empty;
    private string? _pagedPath;
    private string? _cursor;
    private string _pageLabel = string.Empty;
    private string _applied = string.Empty;
    private JToken? _totals;
    private readonly LatestRequest _query = new();
    private bool _resolving;
    private readonly QueryParameterTracker _accountQuery = new();
    private readonly QueryParameterTracker _sessionQuery = new();
    private readonly QueryParameterTracker _itemQuery = new();

    /****************************************
    *              Properties
    ****************************************/

    [SupplyParameterFromQuery(Name = "account")] public string? AccountParameter { get; set; }
    [SupplyParameterFromQuery(Name = "session")] public string? SessionParameter { get; set; }
    [SupplyParameterFromQuery(Name = "item")] public string? ItemParameter { get; set; }

    /****************************************
    *                Methods
    ****************************************/

    // 다른 화면의 ID 링크로 들어오면 해당 조회 탭을 열고 값을 채운다. 조회는 사용자가 직접 실행한다
    protected override void OnParametersSet()
    {
        if (_accountQuery.TryTake(AccountParameter, out string accountId))
        {
            _accountText = accountId;
            SetTab("ledger");
        }
        if (_sessionQuery.TryTake(SessionParameter, out string sessionId))
        {
            _sessionId = sessionId;
            SetTab("session");
        }
        if (_itemQuery.TryTake(ItemParameter, out string itemId))
        {
            _itemId = itemId;
            SetTab("item");
        }
    }

    // 같은 탭을 다시 누르면 아무것도 하지 않는다. 실제로 탭을 바꾸면 이전 조회의 응답과 페이지 상태를 함께 버린다
    private void SetTab(string tab)
    {
        if (tab == _tab)
        {
            return;
        }
        _tab = tab;
        _query.Cancel();
        InvalidateRead();
        _resolving = false;
        _data = null;
        _totals = null;
        _pagedPath = null;
        _cursor = null;
    }

    private void PickLedger((string From, string To) range)
    {
        _from = range.From;
        _to = range.To;
    }

    private void PickAudit((string From, string To) range)
    {
        _auditFrom = range.From;
        _auditTo = range.To;
    }

    private async Task LoadLedgerAsync()
    {
        _error = string.Empty;
        // 계정 확인을 기다리기 전에 요청 세대를 잡고, 기다린 뒤에도 현재 조회인지 확인한다
        int generation = _query.Begin();
        _resolving = true;
        ResolvedAccount? account;
        try
        {
            account = _accountPicker == null ? null : await _accountPicker.EnsureAsync();
        }
        finally
        {
            if (_query.IsCurrent(generation))
            {
                _resolving = false;
            }
        }
        if (!_query.IsCurrent(generation))
        {
            return;
        }
        if ((_accountPicker != null) && (_accountPicker.HasText) && (account == null))
        {
            _error = "계정을 확인하지 못했습니다. 위 입력을 고치세요.";
            return;
        }
        string? path = null;
        Validate(() =>
        {
            string? sourceType = Optional(_sourceType);
            string? sourceId = Optional(_sourceId);
            if ((account == null) && ((sourceType == null) || (sourceId == null)))
            {
                throw new ArgumentException("캐릭터 이름 또는 계정 ID, 혹은 출처 종류와 출처 ID를 함께 입력하세요.");
            }
            if ((Optional(_reasonCode) != null) && (!int.TryParse(_reasonCode, out _)))
            {
                throw new ArgumentException("원장 사유 코드는 숫자입니다.");
            }
            (string? from, string? to, string applied) = Period(_from, _to);
            string limit = Limit(_limit);
            string reason = AdminDefaults.Reason(_reason, AdminDefaults.READ_REASON, out _);
            path = Query(AdminApiRoutes.LEDGER, ("reason", reason),
                ("accountId", account?.AccountId), ("characterId", OptionalId(_characterId, "캐릭터 ID") ?? account?.CharacterId),
                ("sourceType", sourceType), ("sourceId", sourceId), ("assetKind", Optional(_assetKind)),
                ("assetId", Optional(_assetId)), ("reasonCode", Optional(_reasonCode)),
                ("fromUnixMs", from), ("toUnixMs", to), ("limit", limit));
            _applied = applied;
        });
        if (path == null)
        {
            return;
        }
        _pagedPath = path;
        _pageLabel = "원장 페이지";
        _totals = null;
        await ReadAsync(path);
        if (!_query.IsCurrent(generation))
        {
            return;
        }
        _totals = _data?["totals"];
        _cursor = _data?["nextCursor"]?.Value<string>();
    }

    private Task LoadItemAsync() => LoadSensitiveAsync(() => string.Format(AdminApiRoutes.ITEM_HISTORY_FORMAT, Id(_itemId, "아이템 ID")));
    private Task LoadSessionAsync() => LoadSensitiveAsync(() => string.Format(AdminApiRoutes.SESSION_EVENTS_FORMAT, Id(_sessionId, "세션 ID")));
    private Task LoadOperationAsync() => LoadSensitiveAsync(() => string.Format(AdminApiRoutes.OPERATION_FORMAT,
        Id(_actorId, "행위자 ID"), Id(_operationId, "작업 ID")));

    private async Task LoadSensitiveAsync(Func<string> route)
    {
        _query.Begin();
        _resolving = false;
        string? path = null;
        Validate(() => path = Query(route(), ("reason", AdminDefaults.Reason(_reason, AdminDefaults.READ_REASON, out _))));
        if (path != null)
        {
            _pagedPath = null;
            _cursor = null;
            _totals = null;
            await ReadAsync(path);
        }
    }

    private async Task LoadAuditAsync()
    {
        _query.Begin();
        _resolving = false;
        string? path = null;
        Validate(() =>
        {
            if ((!string.IsNullOrWhiteSpace(_targetId)) && (string.IsNullOrWhiteSpace(_targetKind)))
            {
                throw new ArgumentException("대상 ID 필터에는 대상 종류도 입력하세요.");
            }
            (string? from, string? to, string applied) = Period(_auditFrom, _auditTo);
            path = Query(AdminApiRoutes.AUDIT, ("adminId", OptionalId(_auditAdminId, "운영자 ID")),
                ("targetKind", Optional(_targetKind)), ("targetId", Optional(_targetId)),
                ("fromUnixMs", from), ("toUnixMs", to), ("limit", Limit(_auditLimit)));
            _applied = applied;
        });
        if (path == null)
        {
            return;
        }
        _pagedPath = path;
        _pageLabel = "감사 로그 페이지";
        _totals = null;
        await ReadAsync(path);
        _cursor = _data?["nextCursor"]?.Value<string>();
    }

    private async Task NextAsync()
    {
        if ((_pagedPath == null) || (string.IsNullOrEmpty(_cursor)))
        {
            return;
        }
        await ReadAsync(_pagedPath + (_pagedPath.Contains('?') ? "&" : "?") + "cursor=" + Uri.EscapeDataString(_cursor));
        _cursor = _data?["nextCursor"]?.Value<string>();
    }

    private static string Limit(string text)
    {
        int limit = AdminDefaults.Int(text, AdminDefaults.LIST_LIMIT, 1, AdminLogQueryParameters.MAX_LIMIT, "조회 개수", out _);
        return Number(limit);
    }

    /// <summary> 시작이 비면 종료 24시간 전을 쓴다. 종료가 비면 최초 조회 시각으로 고정해 다음 페이지에도 같은 값을 쓴다 </summary>
    private static (string? From, string? To, string Applied) Period(string fromText, string toText)
    {
        (long from, long to, bool toDefaulted) = LogPeriod.Resolve(fromText, toText, DateTimeOffset.UtcNow, AdminDefaults.LOG_RANGE_HOURS);
        string applied = "적용 기간: " + AdminTime.FormatKst(from) + " ~ " + AdminTime.FormatKst(to)
            + (toDefaulted ? " (조회 시작 시각으로 고정)" : string.Empty);
        return (Number(from), Number(to), applied);
    }

    protected override void ClearSensitiveState()
    {
        _totals = null;
        _pagedPath = null;
        _cursor = null;
    }
}
