@page "/notices"
@inherits AdminPageBase
<PageTitle>공지 관리</PageTitle>
<h1>공지 관리</h1>
<RoleRequirement MinimumRole="AdminContractCodes.Role.VIEWER" />
<button type="button" disabled="@_busy" @onclick="LoadAsync">공지 목록 조회</button>
<p class="muted">현재·예정 공지와 종료된 지 7일 이내인 공지를 조회합니다. 시각은 UTC 기준입니다.</p>
<RoleRequirement MinimumRole="AdminContractCodes.Role.OPERATOR" />
<fieldset disabled="@(FormLocked || !Context.HasRole(AdminContractCodes.Role.OPERATOR))">
    <legend>공지 작성</legend>
    <div class="form-grid">
        <label>제목<input @bind="_title" maxlength="100" /></label>
        <label>본문<textarea @bind="_body" rows="5" maxlength="4000"></textarea></label>
        <label>대상<select @bind="_target"><option value="Both">런처·게임</option><option value="Launcher">런처</option><option value="Game">게임</option></select></label>
        <label>중요도<select @bind="_severity"><option value="0">안내</option><option value="1">경고</option><option value="2">긴급</option></select></label>
        <label>시작 시각(UTC, 비우면 즉시)<input @bind="_starts" placeholder="2026-10-07T00:00:00Z" /></label>
        <label>종료 시각(UTC, 필수)<input @bind="_ends" placeholder="2026-10-08T00:00:00Z" /></label>
        <label>작성 사유<input @bind="_createReason" maxlength="500" /></label>
    </div>
    <button type="button" @onclick="PrepareCreate">작성 내용 확인</button>
</fieldset>
<fieldset disabled="@(FormLocked || !Context.HasRole(AdminContractCodes.Role.OPERATOR))">
    <legend>공지 즉시 종료</legend>
    <div class="form-grid"><label>공지 ID<input @bind="_noticeId" /></label><label>종료 사유<input @bind="_endReason" maxlength="500" /></label></div>
    <button type="button" @onclick="PrepareEnd">종료 내용 확인</button>
</fieldset>
<WriteConfirmation Title="@_writeTitle" Target="@_writeTarget" Body="_preparedBody" OperationId="@PendingOperationId" Attempted="_writeAttempted" CanConfirm="CanConfirm" Busy="_busy" OnConfirm="ConfirmAsync" OnCancel="CancelPrepared" />
<ApiResultView Data="_data" Error="@_error" Message="@_message" Busy="_busy" />
@code
{
    /****************************************
    *                Fields
    ****************************************/

    private string _title = string.Empty;
    private string _body = string.Empty;
    private string _target = "Both";
    private int _severity;
    private string _starts = string.Empty;
    private string _ends = string.Empty;
    private string _createReason = string.Empty;
    private string _noticeId = string.Empty;
    private string _endReason = string.Empty;

    /****************************************
    *                Methods
    ****************************************/

    private Task LoadAsync() => ReadAsync(AdminApiRoutes.NOTICES);

    private void PrepareCreate()
    {
        Validate(() =>
        {
            string title = _title.Trim();
            string body = _body;
            if ((title.Length == 0) || (title.Length > AdminNoticeCreateRequest.MAX_TITLE_LENGTH)
                || (body.Length > AdminNoticeCreateRequest.MAX_BODY_LENGTH))
            {
                throw new ArgumentException("제목은 1~100자, 본문은 최대 4,000자입니다.");
            }
            long? starts = UnixTime(_starts, "시작");
            long? ends = UnixTime(_ends, "종료");
            if ((!ends.HasValue) || (ends <= (starts ?? DateTimeOffset.UtcNow.ToUnixTimeMilliseconds())))
            {
                throw new ArgumentException("종료 시각은 시작 시각 이후로 지정하세요.");
            }
            string reason = RequireReason(_createReason);
            string target = _target;
            int severity = _severity;
            Prepare("공지 작성", target + " / " + title, reason, AdminContractCodes.Role.OPERATOR, AdminApiRoutes.NOTICES,
                operation => new AdminNoticeCreateRequest(operation, reason, title, body, target, severity, starts, ends));
        });
    }

    private void PrepareEnd()
    {
        Validate(() =>
        {
            string notice = Id(_noticeId, "공지 ID");
            string reason = RequireReason(_endReason);
            Prepare("공지 종료", notice, reason, AdminContractCodes.Role.OPERATOR,
                string.Format(AdminApiRoutes.NOTICE_END_FORMAT, notice),
                operation => new AdminNoticeEndRequest(operation, reason));
        });
    }
}