@using Newtonsoft.Json.Linq
@if (!string.IsNullOrEmpty(Error))
{
    <p role="alert" class="error">@Error</p>
}
@if (!string.IsNullOrEmpty(Message))
{
    <p role="status" class="success">@Message</p>
}
@if (Busy)
{
    <p role="status">요청 처리 중입니다.</p>
}
@if (Data != null)
{
    <section aria-label="조회 및 처리 결과"><JsonDataView Value="Data" /></section>
}
@code
{
    /****************************************
    *              Properties
    ****************************************/

    [Parameter] public JToken? Data { get; set; }
    [Parameter] public string Error { get; set; } = string.Empty;
    [Parameter] public string Message { get; set; } = string.Empty;
    [Parameter] public bool Busy { get; set; }
}