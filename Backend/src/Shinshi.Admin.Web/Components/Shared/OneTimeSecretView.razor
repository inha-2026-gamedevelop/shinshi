@implements IDisposable
@if (_secrets.Count > 0)
{
    <section class="warning" aria-label="한 번만 표시되는 비밀값">
        <h2>지금 안전하게 보관하세요</h2>
        <p role="alert">이 비밀값은 처음 확정 응답에만 제공됩니다. 다른 화면으로 이동하거나 아래 버튼을 누르면 지웁니다.</p>
        <dl>
        @foreach (KeyValuePair<string, string> secret in _secrets)
        {
            <dt>@secret.Key</dt><dd><code>@secret.Value</code></dd>
        }
        </dl>
        <button type="button" class="secondary" @onclick="Clear">보관 완료 · 화면에서 지우기</button>
    </section>
}
@if (!string.IsNullOrEmpty(_warning))
{
    <p class="warning" role="status">@_warning</p>
}
@code
{
    /****************************************
    *                Fields
    ****************************************/

    private Dictionary<string, string> _secrets = new();
    private string _warning = string.Empty;
    private bool _disposed;

    /****************************************
    *                Methods
    ****************************************/

    public void Show(Dictionary<string, string> secrets, string missingWarning)
    {
        if (_disposed)
        {
            secrets.Clear();
            return;
        }
        ClearValues();
        _secrets = secrets;
        _warning = secrets.Count == 0 ? missingWarning : string.Empty;
        StateHasChanged();
    }

    public void Clear()
    {
        ClearValues();
        if (!_disposed)
        {
            StateHasChanged();
        }
    }

    private void ClearValues()
    {
        _secrets.Clear();
        _warning = string.Empty;
    }

    public void Dispose()
    {
        _disposed = true;
        ClearValues();
    }
}