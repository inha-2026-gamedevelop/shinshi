@inject AdminWebContext Context
<p class="muted">필요 권한: @AdminLabels.Role(MinimumRole). 현재 권한: @AdminLabels.Role(Context.Role).</p>
@if (!Context.HasRole(MinimumRole))
{
    <p class="warning">이 화면의 작업에 필요한 권한이 없습니다.</p>
}
@code
{
    /****************************************
    *              Properties
    ****************************************/

    [Parameter] public int MinimumRole { get; set; }
}