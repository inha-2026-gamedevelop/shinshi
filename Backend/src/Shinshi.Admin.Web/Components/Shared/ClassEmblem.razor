<span class="@("emblem " + AdminClassCatalog.CssClass(ClassId))" role="img" aria-label="@AdminClassCatalog.Name(ClassId)" title="@AdminClassCatalog.Name(ClassId)">
    <svg viewBox="0 0 48 48" aria-hidden="true" focusable="false">
        @if (ClassId == 0)
        {
            @* 무사: 검 *@
            <path d="M24 5 28 9V29H20V9Z" /><path d="M14 29H34" /><path d="M24 29V41" /><path d="M20 41H28" />
        }
        else if (ClassId == 1)
        {
            @* 도술사: 술식 별 *@
            <path d="M24 6 28.2 18.2 40 24 28.2 29.8 24 42 19.8 29.8 8 24 19.8 18.2Z" /><circle cx="24" cy="24" r="3" />
        }
        else if (ClassId == 2)
        {
            @* 신령사: 초승달과 구슬 *@
            <path d="M38 29A15 15 0 1 1 19 10 12 12 0 0 0 38 29Z" /><circle cx="32" cy="15" r="2.5" />
        }
        else
        {
            <circle cx="24" cy="24" r="14" /><path d="M24 18V26" /><path d="M24 31V31.01" />
        }
    </svg>
</span>
@code
{
    /****************************************
    *              Properties
    ****************************************/

    [Parameter] public int ClassId { get; set; }
}
