@inherits LayoutComponentBase
@implements IDisposable
@inject AdminWebContext Session
@inject NavigationManager Navigation

@if (Session.IsAuthenticated)
{
    <div class="admin-shell">
        <header class="topbar">
            <a class="brand" href="/">신시 운영 관리</a>
            <span>@Session.LoginName · @RoleName(Session.Role)</span>
            <form method="post" action="/logout" data-enhance="false">
                <AntiforgeryToken />
                <button class="secondary" type="submit">로그아웃</button>
            </form>
        </header>
        <nav aria-label="운영 메뉴">
            <NavLink href="/" Match="NavLinkMatch.All">대시보드</NavLink>
            <NavLink href="/accounts">계정</NavLink>
            <NavLink href="/invites">초대 코드</NavLink>
            <NavLink href="/grants">지급</NavLink>
            <NavLink href="/service-state">서비스 상태</NavLink>
            <NavLink href="/notices">공지</NavLink>
            <NavLink href="/logs">로그</NavLink>
            <NavLink href="/recovery">장애 복구</NavLink>
            <NavLink href="/operators">운영자 관리</NavLink>
        </nav>
        <main class="workspace">@Body</main>
        <footer>운영자 ID: @Session.AdminId · API 감사 IP는 웹 서버의 주소로 기록됩니다.</footer>
    </div>
}
else
{
    <main class="login-shell"><p>로그인 화면으로 이동 중입니다.</p></main>
}
<div id="blazor-error-ui" role="alert">
    연결에 문제가 생겼습니다. 화면을 다시 열고 로그인 상태와 작업 추적을 확인하세요.
    <a href="/">화면 다시 열기</a>
</div>

@code {
    private bool _disposed;

    protected override void OnInitialized()
    {
        Session.Initialize();
        Session.SessionExpired += OnSessionExpired;
    }

    protected override void OnAfterRender(bool firstRender)
    {
        if (!Session.IsAuthenticated)
        {
            Navigation.NavigateTo("/login", forceLoad: true);
        }
        else if (firstRender)
        {
            Session.StartExpiryMonitoring(action => InvokeAsync(action));
        }
    }

    public void Dispose()
    {
        _disposed = true;
        Session.SessionExpired -= OnSessionExpired;
        Session.StopExpiryMonitoring();
    }

    private void OnSessionExpired()
    {
        _ = InvokeAsync(() =>
        {
            if (!_disposed)
            {
                Navigation.NavigateTo("/login?error=expired", forceLoad: true);
            }
        });
    }

    private static string RoleName(int role)
    {
        return role switch
        {
            AdminContractCodes.Role.VIEWER => "Viewer · 조회",
            AdminContractCodes.Role.OPERATOR => "Operator · 운영",
            AdminContractCodes.Role.ADMIN => "Admin · 서비스 관리",
            AdminContractCodes.Role.OWNER => "Owner · 운영자 관리",
            _ => "알 수 없는 역할"
        };
    }
}