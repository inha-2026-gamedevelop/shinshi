# Reference only. Inject actual values into the process environment, not a file.
ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://+:8080
ConnectionStrings__Postgres=REPLACE_WITH_RUNTIME_DB_CONNECTION_FROM_SECRET_PROVIDER
ServiceState__Maintenance=true
ServiceState__Notice=REPLACE_WITH_MAINTENANCE_NOTICE
ServiceState__AllowedBuildIds__0=REPLACE_WITH_ALLOWED_BUILD_ID
# Migration job only; never inject this credential into the running API.
# ConnectionStrings__PostgresMigrator=REPLACE_WITH_MIGRATION_DB_CONNECTION_FROM_SECRET_PROVIDER
# Observability (deploy/LOGGING.md). Unset values are logged as null.
Observability__InstanceId=REPLACE_WITH_API_INSTANCE_ID
Observability__BuildId=REPLACE_WITH_BUILD_ID
Observability__ContentVersion=REPLACE_WITH_CONTENT_VERSION
# /metrics answers only these CIDRs or IPs (404 elsewhere; empty = loopback only). Use the Prometheus host's private address.
Metrics__AllowedNetworks__0=REPLACE_WITH_PROMETHEUS_HOST_CIDR
