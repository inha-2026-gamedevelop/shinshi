      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "shinshi-prometheus"
          },
          "expr": "count(up{job=\"shinshi-gameserver\", role=~\"$role\", instance=~\"$instance\"} == 0) or vector(0)",
          "legendFormat": "down"
