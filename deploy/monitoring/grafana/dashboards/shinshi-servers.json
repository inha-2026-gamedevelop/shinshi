{
  "uid": "shinshi-servers",
  "title": "Shinshi 게임 서버",
  "tags": [
    "shinshi"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "role",
        "label": "역할",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "shinshi-prometheus"
        },
        "query": {
          "query": "label_values(up{job=\"shinshi-gameserver\"}, role)",
          "refId": "role"
        },
        "definition": "label_values(up{job=\"shinshi-gameserver\"}, role)",
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "refresh": 2,
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "instance",
        "label": "대상",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "shinshi-prometheus"
        },
        "query": {
          "query": "label_values(up{job=\"shinshi-gameserver\", role=~\"$role\"}, instance)",
          "refId": "instance"
        },
        "definition": "label_values(up{job=\"shinshi-gameserver\", role=~\"$role\"}, instance)",
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "refresh": 2,
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "annotations": {
    "list": []
  },
