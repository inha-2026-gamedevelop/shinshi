        "type": "prometheus",
        "uid": "shinshi-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "shinshi-prometheus"
          },
          "expr": "sum(up{job=\"shinshi-gameserver\", role=~\"$role\", instance=~\"$instance\"})",
          "legendFormat": "up"
