# Copy to .env (git ignored) and set a strong password before docker compose up.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=REPLACE_WITH_STRONG_PASSWORD
PROMETHEUS_RETENTION=15d

# Discord-compatible webhook that receives alerts (Alertmanager discord_configs). Required.
# Discord: channel settings > Integrations > Webhooks > copy URL. Treat it as a secret.
ALERT_WEBHOOK_URL=REPLACE_WITH_DISCORD_WEBHOOK_URL
