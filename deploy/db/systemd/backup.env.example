# 예시. /etc/shinshi/db/backup.env 로 복사해 채운다. 비밀번호는 여기에 쓰지 않는다.
# 비밀번호는 PGPASSFILE 이 가리키는 .pgpass 형식 파일(host:port:db:user:password 한 줄, 권한 0600)로만 공급한다.
PGHOST=REPLACE_WITH_DB_HOST
PGPORT=5432
PGDATABASE=shinshi
# pg_dump 는 모든 테이블을 읽어야 한다. 런타임 역할(shinshi_runtime)은 schema_migrations 읽기 권한이 없다(Backend/README.md).
# 전용 읽기 역할(예: pg_read_all_data 멤버)을 쓰는 것이 안전하다. 역할 구성은 미결정.
PGUSER=REPLACE_WITH_BACKUP_ROLE
PGSSLMODE=require
PGPASSFILE=/etc/shinshi/db/pgpass
