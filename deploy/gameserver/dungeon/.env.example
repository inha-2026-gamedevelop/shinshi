# Slot 1 example. Install as /etc/shinshi/gameserver/dungeon-1.env.
# For slot i in 1..N, write GAME_PORT=7780+(i-1) as a calculated decimal value,
# and a unique INSTANCE_ID=dungeon-i. Do not put arithmetic/variables in values.
# The unit fixes -role dungeon; CLI arguments take precedence over environment.
SERVER_ROLE=dungeon
GAME_PORT=7780
INSTANCE_ID=dungeon-1
BACKEND_BASE_URL=https://api.example.invalid
CONTENT_VERSION=REPLACE_WITH_DEPLOYED_CONTENT_VERSION
# Same measured positive integer N as town.env; it is not an assumed 25 or 100.
DUNGEON_POOL_SIZE=REPLACE_WITH_MEASURED_POOL_SIZE
# No service credentials, passwords or tokens belong in this example or CLI.
