# Install as /etc/shinshi/gameserver/town.env after replacing placeholders.
# The unit fixes -role town; CLI arguments take precedence over environment.
SERVER_ROLE=town
GAME_PORT=7777
INSTANCE_ID=town-1
BACKEND_BASE_URL=https://api.example.invalid
CONTENT_VERSION=REPLACE_WITH_DEPLOYED_CONTENT_VERSION
# Positive integer N, determined by Linux server CPU/RSS measurements.
# Set the same N in town.env and every dungeon-N.env. This does not spawn units.
DUNGEON_POOL_SIZE=REPLACE_WITH_MEASURED_POOL_SIZE
# No service credentials, passwords or tokens belong in this example or CLI.
