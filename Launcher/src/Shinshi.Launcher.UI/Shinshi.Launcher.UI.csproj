<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>Shinshi.Launcher</RootNamespace>
    <AssemblyName>ShinshiLauncher</AssemblyName>
    <Version>1.0.0</Version>
    <Product>SHINSHI Launcher</Product>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Shinshi.Patch.Core/Shinshi.Patch.Core.csproj" />
    <ProjectReference Include="../Shinshi.Patch.Client/Shinshi.Patch.Client.csproj" />
    <ProjectReference Include="../Shinshi.Launcher.Account/Shinshi.Launcher.Account.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="launcher.json.example" Link="launcher.example.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
