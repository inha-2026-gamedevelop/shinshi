<Application x:Class="Shinshi.Launcher.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:p="clr-namespace:Shinshi.Launcher.Presentation"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <p:EnumEqualsConverter x:Key="EnumEquals" />
            <p:EnumToVisibilityConverter x:Key="EnumToVisibility" />
            <p:BoolToVisibilityConverter x:Key="BoolToVisibility" />
            <p:EmptyToCollapsedConverter x:Key="EmptyToCollapsed" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
