<Window x:Class="Shinshi.Launcher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:Shinshi.Launcher.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        Title="SHINSHI"
        Width="1280" Height="760" MinWidth="1100" MinHeight="680"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        Background="{StaticResource Brush.Background}"
        FontFamily="{StaticResource Font.Main}"
        Foreground="{StaticResource Brush.TextPrimary}"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="56" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Grid>
        <Grid.Style>
            <Style TargetType="Grid">
                <Style.Triggers>
                    <!-- A maximized chrome-less window extends past the screen by the frame size -->
                    <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}" Value="Maximized">
                        <Setter Property="Margin" Value="7" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Grid.Style>
        <Grid.RowDefinitions>
            <RowDefinition Height="56" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <!-- ============ Top bar ============ -->
        <Border Grid.Row="0" Background="{StaticResource Brush.Sidebar}" BorderBrush="{StaticResource Brush.Divider}"
                BorderThickness="0,0,0,1" />

        <!-- Wordmark and nav tabs -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Left" Margin="24,0,0,0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Width="22" Height="22" CornerRadius="5" Background="{StaticResource Brush.Accent}" Margin="0,0,10,0">
                    <TextBlock Text="S" FontWeight="Black" FontSize="13" Foreground="White" HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                </Border>
                <ItemsControl ItemsSource="{Binding Source='SHINSHI'}" VerticalAlignment="Center" Focusable="False">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" FontSize="17" FontWeight="Black" Margin="0,0,3,0"
                                       Foreground="{StaticResource Brush.TextPrimary}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="56,0,0,0">
                <RadioButton Style="{StaticResource Radio.NavTab}" GroupName="Nav" Content="홈" WindowChrome.IsHitTestVisibleInChrome="True"
                             Command="{Binding NavigateCommand}" CommandParameter="Home"
                             IsChecked="{Binding ActiveTab, Converter={StaticResource EnumEquals}, ConverterParameter=Home, Mode=TwoWay}" />
                <RadioButton Style="{StaticResource Radio.NavTab}" GroupName="Nav" Content="소식" WindowChrome.IsHitTestVisibleInChrome="True"
                             Command="{Binding NavigateCommand}" CommandParameter="News"
                             IsChecked="{Binding ActiveTab, Converter={StaticResource EnumEquals}, ConverterParameter=News, Mode=TwoWay}" />
                <RadioButton Style="{StaticResource Radio.NavTab}" GroupName="Nav" Content="패치노트" WindowChrome.IsHitTestVisibleInChrome="True"
                             Command="{Binding NavigateCommand}" CommandParameter="PatchNotes"
                             IsChecked="{Binding ActiveTab, Converter={StaticResource EnumEquals}, ConverterParameter=PatchNotes, Mode=TwoWay}" />
            </StackPanel>
        </StackPanel>

        <!-- Account, settings, caption buttons -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Style="{StaticResource Button.Outline}" VerticalAlignment="Center" Margin="0,0,8,0" Height="32"
                    WindowChrome.IsHitTestVisibleInChrome="True" Command="{Binding NavigateCommand}" CommandParameter="Login"
                    Visibility="{Binding IsLoggedOut, Converter={StaticResource BoolToVisibility}}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Text.Icon}" Text="&#xE77B;" FontSize="13" Margin="0,0,8,0"
                               Foreground="{StaticResource Brush.TextSecondary}" />
                    <TextBlock Text="로그인" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
            <Button x:Name="AccountButton" Style="{StaticResource Button.Outline}" VerticalAlignment="Center" Margin="0,0,8,0" Height="32"
                    WindowChrome.IsHitTestVisibleInChrome="True" Click="OnAccountClick" ToolTip="계정"
                    Visibility="{Binding IsLoggedIn, Converter={StaticResource BoolToVisibility}}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Text.Icon}" Text="&#xE77B;" FontSize="13" Margin="0,0,8,0"
                               Foreground="{StaticResource Brush.Success}" />
                    <TextBlock Text="{Binding AccountText}" VerticalAlignment="Center" />
                    <TextBlock Style="{StaticResource Text.Icon}" Text="&#xE70D;" FontSize="10" Margin="8,0,0,0"
                               Foreground="{StaticResource Brush.TextSecondary}" />
                </StackPanel>
                <Button.ContextMenu>
                    <ContextMenu Placement="Bottom">
                        <MenuItem Header="로그아웃" Command="{Binding LogoutCommand}" />
                    </ContextMenu>
                </Button.ContextMenu>
            </Button>
            <Button Style="{StaticResource Button.Icon}" Content="&#xE713;" ToolTip="설정" VerticalAlignment="Center" Margin="0,0,12,0"
                    WindowChrome.IsHitTestVisibleInChrome="True" Command="{Binding NavigateCommand}" CommandParameter="Settings" />
            <Rectangle Width="1" Height="20" Fill="{StaticResource Brush.Divider}" VerticalAlignment="Center" Margin="0,0,4,0" />
            <Button Style="{StaticResource Button.Caption}" Content="&#xE921;" ToolTip="최소화" WindowChrome.IsHitTestVisibleInChrome="True"
                    Click="OnMinimizeClick" />
            <Button x:Name="MaximizeButton" Style="{StaticResource Button.Caption}" Content="&#xE922;" ToolTip="최대화"
                    WindowChrome.IsHitTestVisibleInChrome="True" Click="OnMaximizeClick" />
            <Button Style="{StaticResource Button.CaptionClose}" Content="&#xE8BB;" ToolTip="닫기" WindowChrome.IsHitTestVisibleInChrome="True"
                    Click="OnCloseClick" />
        </StackPanel>

        <!-- ============ Main area ============ -->
        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Home -->
            <Grid Grid.Row="0" Visibility="{Binding CurrentView, Converter={StaticResource EnumToVisibility}, ConverterParameter=Home}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" MinHeight="220" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Hero banner -->
                <Grid Grid.Row="0" ClipToBounds="True">
                    <Rectangle Fill="{StaticResource Brush.Hero}" />
                    <Rectangle Fill="{StaticResource Brush.HeroGlow}" />
                    <Rectangle Fill="{StaticResource Brush.HeroEmber}" />
                    <TextBlock Text="SHINSHI" FontSize="150" FontWeight="Black" Foreground="#0DFFFFFF" HorizontalAlignment="Right"
                               VerticalAlignment="Center" Margin="0,0,-12,40" IsHitTestVisible="False" />
                    <Image Source="{Binding KeyArt}" Stretch="UniformToFill" HorizontalAlignment="Center" VerticalAlignment="Center"
                           Visibility="{Binding KeyArt, Converter={StaticResource EmptyToCollapsed}}" />
                    <Rectangle Fill="{StaticResource Brush.HeroSideFade}" />
                    <Rectangle Fill="{StaticResource Brush.HeroFade}" VerticalAlignment="Bottom" Height="180" />
                    <StackPanel VerticalAlignment="Bottom" HorizontalAlignment="Left" Margin="32,0,32,20">
                        <Border Style="{StaticResource Border.Chip}" Margin="0,0,0,10">
                            <TextBlock Text="내부 체험" FontSize="11" FontWeight="Bold" Foreground="{StaticResource Brush.Accent}" />
                        </Border>
                        <TextBlock Text="신시" FontSize="54" FontWeight="Bold" Foreground="{StaticResource Brush.TextPrimary}" />
                        <TextBlock Text="실시간 쿼터뷰 협동 액션 RPG" FontSize="15" Margin="2,4,0,0"
                                   Foreground="{StaticResource Brush.TextSecondary}" />
                    </StackPanel>
                </Grid>

                <!-- Notice / maintenance strip -->
                <Border Grid.Row="1" Margin="32,8,32,0" CornerRadius="6" Padding="14,10" BorderThickness="1"
                        Visibility="{Binding NoticeText, Converter={StaticResource EmptyToCollapsed}}">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="{StaticResource Brush.Panel}" />
                            <Setter Property="BorderBrush" Value="{StaticResource Brush.Divider}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsNoticeMaintenance}" Value="True">
                                    <Setter Property="Background" Value="#262011" />
                                    <Setter Property="BorderBrush" Value="{StaticResource Brush.Warning}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontSize="14" Margin="0,0,10,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Icon}">
                                    <Setter Property="Text" Value="&#xE946;" />
                                    <Setter Property="Foreground" Value="{StaticResource Brush.Accent}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsNoticeMaintenance}" Value="True">
                                            <Setter Property="Text" Value="&#xE7BA;" />
                                            <Setter Property="Foreground" Value="{StaticResource Brush.Warning}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Style="{StaticResource Text.Base}" Text="{Binding NoticeText}" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>

                <!-- News cards -->
                <Grid Grid.Row="2" Margin="32,18,32,20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <DockPanel Margin="0,0,0,10">
                        <Button DockPanel.Dock="Right" Command="{Binding NavigateCommand}" CommandParameter="News" Cursor="Hand"
                                Focusable="False">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <TextBlock x:Name="Label" Text="전체 보기" FontSize="12" Foreground="{StaticResource Brush.TextMuted}"
                                               Background="Transparent" />
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Label" Property="Foreground" Value="{StaticResource Brush.TextPrimary}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <TextBlock Style="{StaticResource Text.Base}" Text="소식" FontSize="15" FontWeight="Bold" />
                    </DockPanel>
                    <ItemsControl Grid.Row="1" ItemsSource="{Binding HomeNews}" Margin="-8,0" Focusable="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="3" Rows="1" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource Button.CardHost}" Margin="8,0"
                                        Command="{Binding DataContext.OpenNewsCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}">
                                <Border Style="{StaticResource Border.Card}" Height="150">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="64" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>
                                        <Border CornerRadius="8,8,0,0">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="{StaticResource Brush.Thumb.Notice}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Category}" Value="Update">
                                                            <Setter Property="Background" Value="{StaticResource Brush.Thumb.Update}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Category}" Value="Event">
                                                            <Setter Property="Background" Value="{StaticResource Brush.Thumb.Event}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Style="{StaticResource Text.Icon}" FontSize="26" Foreground="#40FFFFFF"
                                                       HorizontalAlignment="Right" Margin="0,0,16,0" Text="&#xE789;" />
                                        </Border>
                                        <StackPanel Grid.Row="1" Margin="14,10,14,10">
                                            <Border Style="{StaticResource Border.Chip}">
                                                <TextBlock Text="{Binding CategoryText}" FontSize="11" FontWeight="Bold"
                                                           Foreground="{StaticResource Brush.Accent}" />
                                            </Border>
                                            <TextBlock Style="{StaticResource Text.Base}" Text="{Binding Title}" FontSize="14" FontWeight="SemiBold"
                                                       Margin="0,7,0,0" />
                                            <TextBlock Style="{StaticResource Text.Muted}" Text="{Binding Date}" Margin="0,4,0,0" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,4,0,0"
                                Visibility="{Binding NewsStatusText, Converter={StaticResource EmptyToCollapsed}}">
                        <TextBlock Style="{StaticResource Text.Secondary}" Text="{Binding NewsStatusText}" VerticalAlignment="Center" />
                        <Button Style="{StaticResource Button.Link}" Content="다시 시도" Margin="12,0,0,0" Command="{Binding RetryNewsCommand}"
                                Visibility="{Binding IsNewsRetryVisible, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>
                </Grid>
            </Grid>

            <!-- News list -->
            <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto"
                          Visibility="{Binding CurrentView, Converter={StaticResource EnumToVisibility}, ConverterParameter=News}">
                <StackPanel Margin="40,32,40,24">
                    <TextBlock Style="{StaticResource Text.Heading}" Text="소식" Margin="0,0,0,18" />
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12"
                                Visibility="{Binding NewsStatusText, Converter={StaticResource EmptyToCollapsed}}">
                        <TextBlock Style="{StaticResource Text.Secondary}" Text="{Binding NewsStatusText}" VerticalAlignment="Center" />
                        <Button Style="{StaticResource Button.Link}" Content="다시 시도" Margin="12,0,0,0" Command="{Binding RetryNewsCommand}"
                                Visibility="{Binding IsNewsRetryVisible, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>
                    <ItemsControl ItemsSource="{Binding News}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource Button.CardHost}" Margin="0,0,0,10"
                                        Command="{Binding DataContext.OpenNewsCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}">
                                <Border Style="{StaticResource Border.Card}" Padding="18,14">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Right" Style="{StaticResource Text.Muted}" Text="{Binding Date}"
                                                   VerticalAlignment="Center" />
                                        <Border Style="{StaticResource Border.Chip}" VerticalAlignment="Center" Margin="0,0,12,0">
                                            <TextBlock Text="{Binding CategoryText}" FontSize="11" FontWeight="Bold"
                                                       Foreground="{StaticResource Brush.Accent}" />
                                        </Border>
                                        <TextBlock Style="{StaticResource Text.Base}" Text="{Binding Title}" FontSize="14" VerticalAlignment="Center" />
                                    </DockPanel>
                                </Border>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>

            <!-- Patch notes -->
            <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto"
                          Visibility="{Binding CurrentView, Converter={StaticResource EnumToVisibility}, ConverterParameter=PatchNotes}">
                <StackPanel Margin="40,32,40,24">
                    <TextBlock Style="{StaticResource Text.Heading}" Text="패치노트" Margin="0,0,0,18" />
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12"
                                Visibility="{Binding PatchNotesStatusText, Converter={StaticResource EmptyToCollapsed}}">
                        <TextBlock Style="{StaticResource Text.Secondary}" Text="{Binding PatchNotesStatusText}" VerticalAlignment="Center" />
                        <Button Style="{StaticResource Button.Link}" Content="다시 시도" Margin="12,0,0,0" Command="{Binding RetryNewsCommand}"
                                Visibility="{Binding IsNewsRetryVisible, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>
                    <ItemsControl ItemsSource="{Binding PatchNotes}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource Button.CardHost}" Margin="0,0,0,10"
                                        Command="{Binding DataContext.OpenNewsCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}">
                                <Border Style="{StaticResource Border.Card}" Padding="18,14">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Right" Style="{StaticResource Text.Muted}" Text="{Binding Date}"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Style="{StaticResource Text.Base}" Text="{Binding Title}" FontSize="14" VerticalAlignment="Center" />
                                    </DockPanel>
                                </Border>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>

            <!-- News detail: plain text only, no HTML or link handling -->
            <Grid Grid.Row="0" Visibility="{Binding CurrentView, Converter={StaticResource EnumToVisibility}, ConverterParameter=NewsDetail}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Button Grid.Row="0" Style="{StaticResource Button.Outline}" HorizontalAlignment="Left" Margin="40,24,40,0"
                        Command="{Binding CloseNewsDetailCommand}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Text.Icon}" Text="&#xE72B;" FontSize="12" Margin="0,0,8,0"
                                   Foreground="{StaticResource Brush.TextSecondary}" />
                        <TextBlock Text="뒤로" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" DataContext="{Binding SelectedNews}">
                    <StackPanel Margin="40,20,40,24" MaxWidth="820" HorizontalAlignment="Left">
                        <Border Style="{StaticResource Border.Chip}">
                            <TextBlock Text="{Binding CategoryText}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource Brush.Accent}" />
                        </Border>
                        <TextBlock Style="{StaticResource Text.Heading}" Text="{Binding Title}" TextWrapping="Wrap" TextTrimming="None"
                                   Margin="0,12,0,0" />
                        <TextBlock Style="{StaticResource Text.Muted}" Text="{Binding Date}" Margin="0,6,0,20" />
                        <TextBlock Style="{StaticResource Text.Base}" Text="{Binding Body}" FontSize="14" LineHeight="22"
                                   TextWrapping="Wrap" TextTrimming="None" />
                        <TextBlock Style="{StaticResource Text.Muted}" Text="본문이 없는 공지입니다."
                                   Visibility="{Binding HasBody, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}" />
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- Settings -->
            <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto"
                          Visibility="{Binding CurrentView, Converter={StaticResource EnumToVisibility}, ConverterParameter=Settings}">
                <StackPanel Margin="40,32,40,24" MaxWidth="760" HorizontalAlignment="Left">
                    <TextBlock Style="{StaticResource Text.Heading}" Text="설정" Margin="0,0,0,22" />

                    <TextBlock Style="{StaticResource Text.SectionLabel}" Text="설치 위치" Margin="0,0,0,8" />
                    <Border Background="{StaticResource Brush.Panel}" CornerRadius="6" Padding="16,12" Margin="0,0,0,22">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Style="{StaticResource Button.Outline}" Content="폴더 열기" Margin="12,0,0,0"
                                    Command="{Binding OpenInstallFolderCommand}" />
                            <TextBlock Style="{StaticResource Text.Base}" Text="{Binding InstallRootText}" VerticalAlignment="Center"
                                       ToolTip="{Binding InstallRootText}" />
                        </DockPanel>
                    </Border>

                    <TextBlock Style="{StaticResource Text.SectionLabel}" Text="패치 서버" Margin="0,0,0,8" />
                    <Border Background="{StaticResource Brush.Panel}" CornerRadius="6" Padding="16,12" Margin="0,0,0,22">
                        <TextBlock Style="{StaticResource Text.Base}" Text="{Binding PatchSourceText}" ToolTip="{Binding PatchSourceText}" />
                    </Border>

                    <TextBlock Style="{StaticResource Text.SectionLabel}" Text="채널" Margin="0,0,0,8" />
                    <Border Background="{StaticResource Brush.Panel}" CornerRadius="6" Padding="16,12" Margin="0,0,0,22">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" IsEnabled="{Binding CanChangeChannel}">
                                <RadioButton Style="{StaticResource Radio.Segment}" GroupName="Channel" Content="internal"
                                             IsChecked="{Binding Channel, Converter={StaticResource EnumEquals}, ConverterParameter=internal, Mode=TwoWay}" />
                                <RadioButton Style="{StaticResource Radio.Segment}" GroupName="Channel" Content="stable"
                                             IsChecked="{Binding Channel, Converter={StaticResource EnumEquals}, ConverterParameter=stable, Mode=TwoWay}" />
                            </StackPanel>
                            <TextBlock Style="{StaticResource Text.Muted}" Margin="0,8,0,0" TextWrapping="Wrap"
                                       Text="팀 빌드 런처에서만 채널을 바꿀 수 있습니다. 바꾼 채널은 이번 실행에만 적용됩니다." />
                        </StackPanel>
                    </Border>

                    <TextBlock Style="{StaticResource Text.SectionLabel}" Text="파일" Margin="0,0,0,8" />
                    <Border Background="{StaticResource Brush.Panel}" CornerRadius="6" Padding="16,12">
                        <StackPanel Orientation="Horizontal">
                            <Button Style="{StaticResource Button.Outline}" Content="파일 검증 및 복구" Margin="0,0,8,0"
                                    Command="{Binding RepairCommand}" />
                            <Button Style="{StaticResource Button.Outline}" Content="로그 폴더 열기" Command="{Binding OpenLogFolderCommand}" />
                        </StackPanel>
                    </Border>

                    <TextBlock Style="{StaticResource Text.SectionLabel}" Text="런처 정보" Margin="0,22,0,8" />
                    <Border Background="{StaticResource Brush.Panel}" CornerRadius="6" Padding="16,12">
                        <TextBlock Style="{StaticResource Text.Base}" Text="{Binding LauncherVersionText}" />
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- Login -->
            <Grid Grid.Row="0" Visibility="{Binding CurrentView, Converter={StaticResource EnumToVisibility}, ConverterParameter=Login}">
                <Border Width="400" VerticalAlignment="Center" HorizontalAlignment="Center" Background="{StaticResource Brush.Panel}"
                        CornerRadius="10" Padding="32,28" BorderBrush="{StaticResource Brush.Divider}" BorderThickness="1">
                    <Grid>
                        <!-- Logged out: credentials form -->
                        <StackPanel Visibility="{Binding IsLoggedOut, Converter={StaticResource BoolToVisibility}}"
                                    IsEnabled="{Binding CanSubmitLogin}">
                            <TextBlock Style="{StaticResource Text.Heading}" Text="로그인" />
                            <TextBlock Style="{StaticResource Text.Secondary}" Margin="0,6,0,20" TextWrapping="Wrap"
                                       Text="신시 계정의 아이디와 비밀번호로 로그인합니다." />

                            <TextBlock Style="{StaticResource Text.SectionLabel}" Text="아이디" Margin="0,0,0,6" />
                            <TextBox x:Name="LoginIdInput" Style="{StaticResource Input.Text}" MaxLength="16"
                                     Text="{Binding LoginIdText, UpdateSourceTrigger=PropertyChanged}" KeyDown="OnLoginInputKeyDown" />

                            <TextBlock Style="{StaticResource Text.SectionLabel}" Text="비밀번호" Margin="0,14,0,6" />
                            <PasswordBox x:Name="PasswordInput" Style="{StaticResource Input.Password}" MaxLength="64"
                                         KeyDown="OnLoginInputKeyDown" />

                            <CheckBox Style="{StaticResource Check.Base}" Content="자동 로그인" Margin="0,14,0,0"
                                      IsChecked="{Binding RememberLogin, Mode=TwoWay}" />

                            <TextBlock Style="{StaticResource Text.Base}" Foreground="{StaticResource Brush.Danger}" FontSize="13"
                                       Margin="0,12,0,0" TextWrapping="Wrap" TextTrimming="None" Text="{Binding LoginErrorText}"
                                       Visibility="{Binding LoginErrorText, Converter={StaticResource EmptyToCollapsed}}" />

                            <Button Style="{StaticResource Button.Primary}" MinWidth="0" MinHeight="44" FontSize="15" Margin="0,16,0,0"
                                    Click="OnLoginClick">
                                <TextBlock>
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="로그인" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsLoginBusy}" Value="True">
                                                    <Setter Property="Text" Value="로그인 중..." />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Button>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,16,0,0"
                                        Visibility="{Binding IsSignupAvailable, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Style="{StaticResource Text.Muted}" Text="계정이 없나요?" Margin="0,0,8,0" VerticalAlignment="Center" />
                                <Button Style="{StaticResource Button.Link}" Content="회원가입" Command="{Binding OpenSignupCommand}" />
                            </StackPanel>
                        </StackPanel>

                        <!-- Logged in -->
                        <StackPanel Visibility="{Binding IsLoggedIn, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Style="{StaticResource Text.Heading}" Text="로그인됨" />
                            <TextBlock Style="{StaticResource Text.Secondary}" Margin="0,6,0,20" TextWrapping="Wrap"
                                       Text="{Binding AccountText, StringFormat='계정 {0}'}" />
                            <Button Style="{StaticResource Button.Outline}" Content="로그아웃" Command="{Binding LogoutCommand}"
                                    HorizontalAlignment="Left" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <!-- Error bar overlays the top of the content so the hero does not jump -->
            <Border Grid.Row="0" VerticalAlignment="Top" Margin="24,16,24,0" CornerRadius="6" Padding="14,10" Background="#2A1517"
                    BorderBrush="{StaticResource Brush.Danger}" BorderThickness="1" Panel.ZIndex="10"
                    Visibility="{Binding ErrorMessage, Converter={StaticResource EmptyToCollapsed}}">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource Button.Icon}" Width="28" Height="28" FontSize="11" Content="&#xE711;"
                            ToolTip="닫기" Command="{Binding DismissErrorCommand}" />
                    <TextBlock Style="{StaticResource Text.Icon}" Text="&#xE783;" Foreground="{StaticResource Brush.Danger}" Margin="0,0,10,0" />
                    <TextBlock Style="{StaticResource Text.Base}" Text="{Binding ErrorMessage}" TextWrapping="Wrap" TextTrimming="None"
                               VerticalAlignment="Center" />
                </DockPanel>
            </Border>

            <!-- ============ Action bar ============ -->
            <Border Grid.Row="1" Background="{StaticResource Brush.Sidebar}" BorderBrush="{StaticResource Brush.Divider}" BorderThickness="0,1,0,0"
                    Padding="32,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Install info -->
                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,24,0">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <Ellipse Width="6" Height="6" Margin="0,0,6,0" VerticalAlignment="Center">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="{StaticResource Brush.TextMuted}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding State}" Value="Ready">
                                                <Setter Property="Fill" Value="{StaticResource Brush.Success}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding State}" Value="GameRunning">
                                                <Setter Property="Fill" Value="{StaticResource Brush.Success}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding State}" Value="UpdateAvailable">
                                                <Setter Property="Fill" Value="{StaticResource Brush.Warning}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding State}" Value="NotInstalled">
                                                <Setter Property="Fill" Value="{StaticResource Brush.Warning}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding State}" Value="Updating">
                                                <Setter Property="Fill" Value="{StaticResource Brush.Accent}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding State}" Value="Repairing">
                                                <Setter Property="Fill" Value="{StaticResource Brush.Accent}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding State}" Value="CheckFailed">
                                                <Setter Property="Fill" Value="{StaticResource Brush.Danger}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding State}" Value="ConfigError">
                                                <Setter Property="Fill" Value="{StaticResource Brush.Danger}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding State}" Value="LauncherOutdated">
                                                <Setter Property="Fill" Value="{StaticResource Brush.Danger}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock Style="{StaticResource Text.Secondary}" FontSize="12" Text="{Binding GameStatusText}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Text.Base}" FontWeight="SemiBold" Text="{Binding VersionText}" />
                            <TextBlock Style="{StaticResource Text.Muted}" Text="|" Margin="10,0" VerticalAlignment="Center" />
                            <TextBlock Style="{StaticResource Text.Secondary}" Text="{Binding ChannelText}" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource Text.Base}" Foreground="{StaticResource Brush.Accent}" FontSize="12" Margin="0,4,0,0"
                                   Text="{Binding UpdateInfoText}" Visibility="{Binding UpdateInfoText, Converter={StaticResource EmptyToCollapsed}}" />
                        <TextBlock Style="{StaticResource Text.Muted}" Margin="0,4,0,0" Text="{Binding InstallPathText}"
                                   ToolTip="{Binding InstallPathText}" />
                    </StackPanel>

                    <!-- Progress -->
                    <Grid Grid.Column="1" Width="340" Margin="0,0,24,0" VerticalAlignment="Center"
                          Visibility="{Binding IsOperationRunning, Converter={StaticResource BoolToVisibility}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <DockPanel Grid.Row="0">
                            <TextBlock DockPanel.Dock="Right" Style="{StaticResource Text.Base}" FontWeight="Bold"
                                       Foreground="{StaticResource Brush.Accent}" Text="{Binding ProgressPercentText}" />
                            <TextBlock Style="{StaticResource Text.Base}" FontWeight="SemiBold" Text="{Binding ProgressStageText}" />
                        </DockPanel>
                        <ProgressBar Grid.Row="1" Style="{StaticResource Progress.Thin}" Margin="0,8" Minimum="0" Maximum="100"
                                     Value="{Binding ProgressPercent, Mode=OneWay}" IsIndeterminate="{Binding IsProgressIndeterminate, Mode=OneWay}" />
                        <DockPanel Grid.Row="2">
                            <TextBlock DockPanel.Dock="Right" Style="{StaticResource Text.Muted}" Text="{Binding ProgressSpeedText}" />
                            <TextBlock Style="{StaticResource Text.Muted}" Text="{Binding ProgressSizeText}" />
                        </DockPanel>
                    </Grid>

                    <!-- Primary + more -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource Button.Primary}" Content="{Binding PrimaryText}" Command="{Binding PrimaryCommand}"
                                Visibility="{Binding IsSecondaryStyle, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}" />
                        <Button Style="{StaticResource Button.PrimarySecondary}" Content="{Binding PrimaryText}" Command="{Binding PrimaryCommand}"
                                Visibility="{Binding IsSecondaryStyle, Converter={StaticResource BoolToVisibility}}" />
                        <Button x:Name="MoreButton" Style="{StaticResource Button.More}" Content="&#xE712;" Margin="8,0,0,0" ToolTip="더 보기"
                                Click="OnMoreClick">
                            <Button.ContextMenu>
                                <ContextMenu Placement="Top">
                                    <MenuItem Header="파일 검증 및 복구" Command="{Binding RepairCommand}" />
                                    <MenuItem Header="설치 폴더 열기" Command="{Binding OpenInstallFolderCommand}" />
                                    <MenuItem Header="로그 폴더 열기" Command="{Binding OpenLogFolderCommand}" />
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
